# ═══════════════════════════════════════════════════════════════════════
# The Docker installer (`install.sh`) generates this file automatically.
# For a manual install: fill in these values, then run
# `bun run provision migrate` and `bun run provision create-admin <login>`.
# ═══════════════════════════════════════════════════════════════════════

# === Database (REQUIRED) ===
# drizzle initializes when the module loads: without DATABASE_URL, the server
# crashes before it can even serve a route.
DATABASE_URL=postgresql://user:password@localhost:5432/humble_planning

# === Authentication (REQUIRED) ===
# BETTER_AUTH_URL: public URL of the app (Better Auth uses it for
# callbacks/redirects). Must match the real domain in prod.
BETTER_AUTH_URL=https://planning.yourdomain.com

# === Application (REQUIRED) ===
# Used by server.ts (Socket.io CORS) and various services.
APP_BASE_URL=https://planning.yourdomain.com
NODE_ENV=production
PORT=3000
SOCKET_PORT=3001

# ═══════════════════════════════════════════════════════════════════════
# SECRETS: generated by `install.sh` (never overwritten if they already exist).
# For a manual install: `openssl rand -hex 32` for each one.
# ═══════════════════════════════════════════════════════════════════════

BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
SOCKET_SECRET=generate-with-openssl-rand-hex-32
BACKUP_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# --- ALTCHA (self-hosted captcha, privacy-first alternative to Turnstile/reCAPTCHA) ---
# 2 separate HMAC secrets used to sign the challenges and their derived
# key. Generated automatically by install.sh. Docs: https://altcha.org/docs/v2/
ALTCHA_HMAC_SECRET=generate-with-openssl-rand-hex-32
ALTCHA_HMAC_KEY_SECRET=generate-with-openssl-rand-hex-32


# --- Mail ---
NUNTLY_API_KEY=
NUNTLY_WEBHOOK_SECRET=



TIMEZONE=Europe/Paris
UPLOAD_DIR=./uploads

# ═══════════════════════════════════════════════════════════════════════
# OPTIONAL
# ═══════════════════════════════════════════════════════════════════════

# --- Ports ---
# Listening ports INSIDE the containers (3000 = application, 3001 = Socket.io).
# With Docker, do not change them: to change the ports published on the host
# (127.0.0.1 only), use HP_APP_PORT / HP_SOCKET_PORT, and
# HP_HTTP_PORT / HP_HTTPS_PORT for Caddy (variables read by docker compose).
# PORT=3000
# SOCKET_PORT=3001

# --- Demo mode (public demonstration instance, see docs/installation.md) ---
# ⚠ Demo mode ERASES ALL THE DATA every night and at each start: never enable it
# on an instance holding real data.
# true = demo dataset, no administration, e-mails/SMS/uploads/update checks off.
# DEMO_MODE=true
# Demo account username, shown on the sign-in page.
# DEMO_LOGIN=demo
# Demo account password: public, shown on the sign-in page.
# DEMO_PASSWORD=demo
# Daily reset time (HH:MM, in the TIMEZONE time zone).
# DEMO_RESET_TIME=03:00

# --- Email secrets (take precedence over the DB value, field greyed out in Settings) ---
# NUNTLY_API_KEY=
# NUNTLY_WEBHOOK_SECRET=whsec_...
# SMTP_PASSWORD=
# MAILGUN_API_KEY=

# --- AI chat (Settings > AI > AI chat) ---
# OpenRouter key: takes precedence over the value entered in the admin (the field
# is then read-only), and recommended here because the DB stores it in clear text.
# OPENROUTER_API_KEY=sk-or-v1-...
# Development and tests only: URL of an OpenRouter-compatible server
# (simulator). Do not set in production.
# OPENROUTER_BASE_URL=http://127.0.0.1:4010/api/v1

# --- Version (set automatically by the build via next.config.ts) ---
# NEXT_PUBLIC_APP_VERSION=1.0.0

# --- Updates (Settings > Version and `humble-planning update`) ---
# GitHub repository whose releases are read (set by install.sh).
# HUMBLE_UPDATE_REPO=Malfhas/HumblePlanning

# --- HTTP compression (enable behind a reverse proxy that compresses) ---
# `apiSuccessCompressed` (used on /api/tasks and other heavy endpoints)
# gzips via synchronous zlib in Node: costs 50-100 ms of CPU per
# request on large payloads (~6 MB).
#
# With Docker + Caddy (`encode zstd gzip` in the Caddyfile), install.sh
# enables this variable: Node returns raw JSON and Caddy compresses on the fly
# natively, which frees the event loop. Behind another reverse proxy,
# enable it only if the proxy compresses itself (e.g. nginx:
# `gzip on; gzip_types application/json;`).
#
# Leave it COMMENTED OUT without a reverse proxy (local dev): Node will
# then compress by itself to avoid sending ~6 MB over the loopback.
# TRUST_PROXY_COMPRESSION=true

# Client address (rate limits, brute-force lockout, audit log). The reverse
# proxy must overwrite X-Real-IP with the address of the connection (the
# Caddyfile and the nginx example do). Set TRUSTED_PROXY=cloudflare only when
# the site is served through the Cloudflare proxy and the server accepts
# traffic from Cloudflare alone: CF-Connecting-IP is then used. Otherwise
# that header is ignored, since any client can send it.
# TRUSTED_PROXY=cloudflare
