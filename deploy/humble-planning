#!/usr/bin/env bash
#
# humble-planning — manage the Humble Planning instances of this server
# (Docker Compose). Installed by install.sh as /usr/local/bin/humble-planning.
#
# Run `humble-planning help` for the list of commands.
#
# Instances: several Humble Planning instances can share a server, each with
# its own short name, label, directory, Compose project, database, files,
# backups and version. install.sh registers them in
# /etc/humble-planning/instances/<name>.conf; HUMBLE_BASE_DIR in
# /etc/default/humble-planning (/opt/humble-planning) holds:
#   instances/<name>/   docker-compose.yml, .env and backups/ of an instance
#                       (an installation made with 1.0.x keeps its directory
#                       and its Compose project "humbleplanning")
#   proxy/              the reverse proxy (Caddy) shared by the instances
# Per-instance commands take the name: `humble-planning status <instance>`. It
# can be left out when there is only one instance; with several, the command
# asks in a terminal, or stops with the list. `remove` always needs the name.
#
# Updates: the releases come from the GitHub API (HUMBLE_UPDATE_REPO in .env,
# or HUMBLE_UPDATE_SOURCE: any URL returning a GitHub-style JSON array of
# releases, e.g. file:///srv/releases.json for tests). The installed version
# lives in .env (HUMBLE_VERSION) and is only changed once an update succeeded:
# on failure, the previous version is started again and the database is
# restored from the backup taken just before the update. Several instances
# are updated one after the other, each with its own backup and rollback.
#
# Shared reverse proxy: one Caddy container (Compose project
# "humbleplanning-proxy") serves every instance that uses it, through the
# Docker network "humbleplanning-proxy", with one site file per instance.
# Every change is checked (caddy validate) before a hot reload; when it fails,
# the previous files are restored and Caddy keeps its running configuration.
# Its image follows the newest version installed on this server. Commands used
# by install.sh (not listed by `help`):
#   proxy add-site <instance> [--token-stdin]   (re)generate the site of an
#                                               instance, then apply it
#   proxy adopt <instance> [--token-stdin]      move the Caddy of a 1.0.x
#                                               installation into the shared
#                                               proxy, with its certificates
#   proxy upgrade <version>                     move the proxy to a newer image
# --token-stdin reads the Cloudflare API token of the site on stdin.
#
# New instance: `humble-planning new` downloads install.sh from the tag of the
# latest published release (same release list as `update`: no draft, no
# pre-release, highest X.Y.Z), checks it, then runs it with HP_ACTION=new; the
# HP_* variables of the environment reach it (non-interactive mode). Internal
# variable, for tests and mirrors (root only, like the whole command):
#   HUMBLE_INSTALLER_URL   URL of install.sh, "{tag}" replaced by the release tag
#                          (https://raw.githubusercontent.com/<repo>/{tag}/install.sh)
#
# The scripts follow the release (from 1.1.2): before touching any instance,
# `update` installs the humble-planning command of the target release (the
# previous one kept as humble-planning.prev), then runs it again with the
# same arguments; each updated instance gets the Compose files of its new
# version (previous ones kept for the rollback), and the proxy gets its files
# when its image moves forward. Never older than the newest version installed
# on the server. Source: the directory HUMBLE_BUILD_SOURCE when the images
# are built from one, nothing with HUMBLE_PULL=0 (offline), else the release
# tag on GitHub. Internal variable, for tests and mirrors:
#   HUMBLE_SCRIPTS_URL     base URL of the repository files, "{tag}" replaced
#                          (https://raw.githubusercontent.com/<repo>/{tag})

set -Eeuo pipefail

if locale -a 2>/dev/null | grep -qiE '^c\.utf-?8$'; then
  export LC_ALL=C.UTF-8
fi

CONFIG_FILE=/etc/default/humble-planning
HUMBLE_BASE_DIR="" HUMBLE_INSTALL_DIR=""
if [ -r "$CONFIG_FILE" ]; then
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
fi
BASE_DIR=${HUMBLE_BASE_DIR:-/opt/humble-planning}
LEGACY_DIR=${HUMBLE_INSTALL_DIR:-}
REGISTRY_DIR=/etc/humble-planning/instances
LOG_DIR=/var/log/humble-planning
FINAL_BACKUP_DIR=/var/backups/humble-planning
LOCK_DIR=/run/lock
PROXY_DIR="$BASE_DIR/proxy"
PROXY_ENV="$PROXY_DIR/.env"
PROXY_CONF="$PROXY_DIR/caddy" # mounted at /etc/caddy/humble in the proxy
PROXY_NETWORK=humbleplanning-proxy
CADDY_CONFIG=(--config /etc/caddy/humble/Caddyfile --adapter caddyfile)
NAME_PATTERN='^[a-z0-9][a-z0-9-]{0,30}[a-z0-9]$'
KEEP_PRE_UPDATE_BACKUPS=5
DEFAULT_UPDATE_REPO=Malfhas/HumblePlanning
DEFAULT_IMAGE_REPO=ghcr.io/malfhas/humble-planning
DEFAULT_CADDY_REPO=ghcr.io/malfhas/humble-planning-caddy
INSTALL_COMMAND="curl -fsSL https://raw.githubusercontent.com/Malfhas/HumblePlanning/main/install.sh | sudo bash"
NEW_HINT="sudo humble-planning new (or: $INSTALL_COMMAND)"
UNIT=humble-planning-update # template units: humble-planning-update@<instance>.timer
LEGACY_UNIT=humble-planning-update
SYSTEMD_DIR=/etc/systemd/system
CRON_PREFIX=/etc/cron.d/humble-planning-update
SELF=$(readlink -f "${BASH_SOURCE[0]}")
WRAPPER_PATH=/usr/local/bin/humble-planning
SELF_UPDATE_MIN=1.1.2 # first release whose command updates itself
ORIG_ARGS=()
TMP_DIR=""
SPINNER_PID=""
AUTO=0
# The selected instance (select_instance)
NAME="" LABEL="" INSTALL_DIR="" ENV_FILE="" BACKUP_DIR="" STATE_FILE="" LOCK_FILE="" REL_OUT=""
UPDATE_LOG="$LOG_DIR/humble-planning.log"
RESULT_FILE=""

# ─── Output ──────────────────────────────────────────────────────────────────

setup_colors() {
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ] && [ "$AUTO" = 0 ]; then
    IS_TTY=1
    RESET=$'\033[0m' BOLD=$'\033[1m' DIM=$'\033[2m'
    RED=$'\033[38;5;203m' GREEN=$'\033[38;5;41m' YELLOW=$'\033[38;5;220m' ACCENT=$'\033[38;5;135m'
  else
    IS_TTY=0
    RESET="" BOLD="" DIM="" RED="" GREEN="" YELLOW="" ACCENT=""
  fi
}
setup_colors

strip_ansi() { printf '%s' "$1" | sed -E $'s/\033\\[[0-9;?]*[A-Za-z]//g'; }
log() {
  { [ -d "$(dirname "$UPDATE_LOG")" ] && printf '%s %s\n' "$(date '+%F %T')" "$(strip_ansi "$*")" >>"$UPDATE_LOG"; } 2>/dev/null || true
}
say()  { printf '%s\n' "$*"; [ "$AUTO" = 1 ] || log "$*"; }
ok()   { say "  ${GREEN}✔${RESET} $*"; }
warn() { say "  ${YELLOW}⚠${RESET} $*"; }
bad()  { say "  ${RED}✖${RESET} $*"; }
info() { say "  ${DIM}•${RESET} $*"; }
title() { say ""; say "${BOLD}${ACCENT}$*${RESET}"; }

die() {
  trap - ERR
  spinner_stop
  bad "$1"
  exit "${2:-1}"
}

quit() { info "$1"; exit 0; }

spinner_stop() {
  if [ -n "$SPINNER_PID" ]; then
    kill "$SPINNER_PID" 2>/dev/null || true
    wait "$SPINNER_PID" 2>/dev/null || true
    SPINNER_PID=""
    printf '\033[?25h'
  fi
  return 0
}

fmt_duration() {
  if [ "$1" -ge 60 ]; then printf '%dm%02ds' $(($1 / 60)) $(($1 % 60)); else printf '%ds' "$1"; fi
}

# spin "Message" command… — output of the command → log; ✔/✖; returns its code
spin() {
  local msg=$1; shift
  local start=$SECONDS rc=0 pid
  log "RUN   $msg :: $*"
  ( trap - ERR; "$@" ) >>"$UPDATE_LOG" 2>&1 </dev/null &
  pid=$!
  if [ "$IS_TTY" = 1 ]; then
    (
      trap - ERR
      frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏); i=0
      printf '\033[?25l'
      while :; do
        printf '\r  %s%s%s %s %s%s%s\033[K' "$ACCENT" "${frames[i % 10]}" "$RESET" "$msg" "$DIM" "$(fmt_duration $((SECONDS - start)))" "$RESET"
        i=$((i + 1)); sleep 0.1
      done
    ) &
    SPINNER_PID=$!
  fi
  wait "$pid" || rc=$?
  spinner_stop
  [ "$IS_TTY" = 1 ] && printf '\r\033[K'
  if [ "$rc" -eq 0 ]; then ok "$msg ${DIM}($(fmt_duration $((SECONDS - start))))${RESET}"; else bad "$msg"; fi
  return "$rc"
}

# A person answers the questions: a terminal on both ends, no --auto.
interactive() { [ "$AUTO" = 0 ] && [ -t 0 ] && [ -t 1 ] && { : </dev/tty; } 2>/dev/null; }

confirm() { # confirm "Question" y|n
  local ans hint=y/N
  [ "$2" = y ] && hint=Y/n
  { : </dev/tty; } 2>/dev/null || { [ "$2" = y ]; return; }
  printf '  %s?%s %s %s[%s]%s ' "$ACCENT" "$RESET" "$1" "$DIM" "$hint" "$RESET"
  IFS= read -r ans </dev/tty || return 1
  ans=${ans:-$2}
  case "${ans,,}" in y|yes) return 0 ;; *) return 1 ;; esac
}

# excerpt FILE LINES TITLE — last lines of a log, cut to the terminal width
excerpt() {
  [ -s "$1" ] || return 0
  local width=$(( ${COLUMNS:-$(tput cols 2>/dev/null || echo 100)} - 8 ))
  say ""
  say "  ${DIM}$3${RESET}"
  tail -n "$2" "$1" | sed -E $'s/\033\\[[0-9;?]*[A-Za-z]//g' | cut -c "1-$width" | sed "s/^/    ${DIM}│${RESET} /"
}

last_log_lines() { excerpt "$UPDATE_LOG" "${1:-20}" "Last lines of $UPDATE_LOG:"; }

# pad TEXT WIDTH — TEXT cut or padded to WIDTH characters
pad() {
  local t=$1 w=$2
  [ "${#t}" -gt "$w" ] && t="${t:0:$((w - 1))}…"
  printf '%s%*s' "$t" $((w - ${#t})) ''
}

# ─── Key=value files (.env, registry) ────────────────────────────────────────

kv_get() { # kv_get FILE KEY — last value of KEY, quotes removed
  local line val=""
  [ -r "$1" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    if [[ $line =~ ^[[:space:]]*$2=(.*)$ ]]; then val=${BASH_REMATCH[1]}; fi
  done <"$1"
  val=${val%$'\r'}
  if [[ $val =~ ^\"(.*)\"$ ]] || [[ $val =~ ^\'(.*)\'$ ]]; then val=${BASH_REMATCH[1]}; fi
  printf '%s' "$val"
}

# kv_set FILE MODE KEY VALUE… — atomic update (missing keys are appended)
kv_set() {
  local file=$1 mode=$2 tmp line key; shift 2
  declare -A new=()
  while [ $# -ge 2 ]; do new[$1]=$2; shift 2; done
  tmp=$(mktemp "$file.XXXXXX")
  chmod "$mode" "$tmp"
  if [ -f "$file" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      if [[ $line =~ ^([A-Z_][A-Z0-9_]*)= ]] && [ -n "${new[${BASH_REMATCH[1]}]+x}" ]; then
        key=${BASH_REMATCH[1]}
        printf '%s=%s\n' "$key" "${new[$key]}" >>"$tmp"
        unset "new[$key]"
      else
        printf '%s\n' "$line" >>"$tmp"
      fi
    done <"$file"
  fi
  for key in "${!new[@]}"; do printf '%s=%s\n' "$key" "${new[$key]}" >>"$tmp"; done
  mv -f "$tmp" "$file"
}

env_get() { kv_get "$ENV_FILE" "$1"; }
env_set() { kv_set "$ENV_FILE" 600 "$@"; }
penv_get() { kv_get "$PROXY_ENV" "$1"; }

# version_gt A B → A > B (X.Y.Z)
version_gt() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" = "$1" ]; }

# ─── Instances ───────────────────────────────────────────────────────────────

instance_names() {
  local f
  for f in "$REGISTRY_DIR"/*.conf; do
    [ -f "$f" ] || continue
    f=${f##*/}; printf '%s\n' "${f%.conf}"
  done | sort
}

is_instance() { [[ $1 =~ $NAME_PATTERN ]] && [ -f "$REGISTRY_DIR/$1.conf" ]; }
reg_get() { kv_get "$REGISTRY_DIR/$1.conf" "$2"; }
proxied() { [ "$(reg_get "${1:-$NAME}" CADDY)" = 1 ]; }

# select_instance NAME — the globals of the commands point to this instance
select_instance() {
  NAME=$1
  LABEL=$(reg_get "$NAME" LABEL)
  INSTALL_DIR=$(reg_get "$NAME" DIR)
  ENV_FILE="$INSTALL_DIR/.env"
  BACKUP_DIR="$INSTALL_DIR/backups"
  STATE_FILE="$INSTALL_DIR/.update-state"
  LOCK_FILE="$LOCK_DIR/humble-planning-$NAME.lock"
  UPDATE_LOG="$LOG_DIR/$NAME.log"
  REL_OUT="$TMP_DIR/releases.$NAME.out"
  [ -n "$INSTALL_DIR" ] && [ -f "$ENV_FILE" ] && [ -f "$INSTALL_DIR/docker-compose.yml" ] ||
    die "Instance $NAME: no installation found in ${INSTALL_DIR:-?} (see $REGISTRY_DIR/$NAME.conf)."
  touch "$UPDATE_LOG" 2>/dev/null && chmod 600 "$UPDATE_LOG" 2>/dev/null || true
}

require_root() {
  [ "$(id -u)" -eq 0 ] || die "Run this command as root: sudo humble-planning $*"
  install -d -m 0750 "$LOG_DIR" 2>/dev/null || true
  touch "$UPDATE_LOG" 2>/dev/null && chmod 600 "$UPDATE_LOG" 2>/dev/null || true
}

# An installation made with 1.0.x is registered by the installer, which also
# moves its Caddy into the shared proxy: this command does not touch it.
check_legacy() {
  local dir=${LEGACY_DIR:-/opt/humble-planning}
  [ -n "$(instance_names)" ] && return 0
  if [ -f "$dir/.env" ] && [ -f "$dir/docker-compose.yml" ]; then
    die "The installation in $dir was made with Humble Planning 1.0.x and is not registered yet. Run the installer once to take it over (nothing is moved, the data is kept): $INSTALL_COMMAND"
  fi
}

instance_url() { kv_get "$(reg_get "$1" DIR)/.env" APP_BASE_URL; }
instance_version() { kv_get "$(reg_get "$1" DIR)/.env" HUMBLE_VERSION; }

# instance_state NAME → running | stopped | unhealthy | partial (n/m) | ?
instance_state() {
  local project services total=0 up=0 sick=0 svc st status
  project=$(kv_get "$(reg_get "$1" DIR)/.env" COMPOSE_PROJECT_NAME)
  [ -n "$project" ] || { printf '?'; return 0; }
  services=$(docker ps -a --filter "label=com.docker.compose.project=$project" --filter label=com.docker.compose.oneoff=False \
    --format '{{.Label "com.docker.compose.service"}}|{{.State}}|{{.Status}}' 2>/dev/null) || { printf '?'; return 0; }
  while IFS='|' read -r svc st status; do
    case "$svc" in app|socket|db) ;; *) continue ;; esac
    total=$((total + 1))
    [ "$st" = running ] && up=$((up + 1))
    [[ $status == *unhealthy* ]] && sick=1
  done <<<"$services"
  if [ "$total" = 0 ] || [ "$up" = 0 ]; then printf 'stopped'
  elif [ "$sick" = 1 ]; then printf 'unhealthy'
  elif [ "$up" = "$total" ]; then printf 'running'
  else printf 'partial (%d/%d)' "$up" "$total"
  fi
}

# print_instances [numbered] — table of the instances (EXTRA[name]: last column)
declare -A EXTRA=()
print_instances() {
  local numbered=${1:-0} n i=0 prefix
  say ""
  prefix="    "; [ "$numbered" = 1 ] && prefix="        "
  say "  ${DIM}${prefix}$(pad NAME 14) $(pad LABEL 26) $(pad URL 32) $(pad VERSION 9) ${EXTRA[__header]:-STATE}${RESET}"
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    i=$((i + 1))
    prefix="    "; [ "$numbered" = 1 ] && prefix="    ${ACCENT}$(printf '%2d' "$i")${RESET}) "
    say "  ${prefix}${BOLD}$(pad "$n" 14)${RESET} $(pad "$(reg_get "$n" LABEL)" 26) $(pad "$(instance_url "$n")" 32) $(pad "v$(instance_version "$n")" 9) ${EXTRA[$n]:-$(instance_state "$n")}"
  done < <(instance_names)
}

# pick_instance COMMAND — the instance chosen in a terminal, else the list and an error
pick_instance() {
  local cmd=$1 names ans i
  mapfile -t names < <(instance_names)
  if ! interactive; then
    print_instances
    say ""
    die "Several instances are installed: name one, e.g. humble-planning $cmd ${names[0]}" 2
  fi
  say ""
  say "  ${BOLD}Several instances are installed on this server.${RESET}"
  print_instances 1
  while :; do
    printf '\n  %s?%s Instance (number or name) %s[1]%s ' "$ACCENT" "$RESET" "$DIM" "$RESET"
    IFS= read -r ans </dev/tty || die "No input available." 2
    ans=${ans:-1}
    if [[ $ans =~ ^[0-9]+$ ]] && [ "$ans" -ge 1 ] && [ "$ans" -le "${#names[@]}" ]; then PICKED=${names[ans - 1]}; return 0; fi
    for i in "${names[@]}"; do [ "$i" = "$ans" ] && { PICKED=$i; return 0; }; done
    printf '    %s✖ Enter a number between 1 and %d, or an instance name.%s\n' "$RED" "${#names[@]}" "$RESET"
  done
}

# split_args COMMAND ARGS… → INSTANCE_ARG (first instance name) and ARGS
# (the rest). A word that is neither an option, an instance nor a word the
# command accepts stops with an error.
split_args() {
  local cmd=$1 a allowed=" "; shift
  case "$cmd" in
    logs|restart|status) allowed=" app socket db caddy " ;;
    auto-update) allowed=" on off enable disable status " ;;
  esac
  INSTANCE_ARG="" ARGS=()
  for a in "$@"; do
    if [ -z "$INSTANCE_ARG" ] && [[ $a != -* ]] && is_instance "$a"; then
      INSTANCE_ARG=$a
    elif [[ $a == -* ]] || [[ $allowed == *" $a "* ]]; then
      ARGS+=("$a")
    else
      print_instances
      die "Unknown instance or argument: $a" 2
    fi
  done
}

# resolve_instance COMMAND — selects INSTANCE_ARG, the only instance, or the one picked
resolve_instance() {
  local cmd=$1 names
  check_legacy
  mapfile -t names < <(instance_names)
  if [ -n "$INSTANCE_ARG" ]; then
    select_instance "$INSTANCE_ARG"
  elif [ "${#names[@]}" -eq 0 ]; then
    die "No Humble Planning instance is installed on this server. Install one: $NEW_HINT"
  elif [ "${#names[@]}" -eq 1 ]; then
    select_instance "${names[0]}"
  else
    PICKED=""
    pick_instance "$cmd"
    select_instance "$PICKED"
  fi
}

take_lock() {
  install -d -m 0755 "$LOCK_DIR" 2>/dev/null || true
  exec 9>"$LOCK_FILE"
  flock -n 9 || die "Another humble-planning operation is already running on the instance $NAME."
}

wait_http() { # wait_http URL TIMEOUT [curl options…]
  local url=$1 timeout=$2 i code=""; shift 2
  for ((i = 0; i < timeout; i += 2)); do
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "$@" "$url" || true)
    [ "$code" = 200 ] && return 0
    sleep 2
  done
  echo "No HTTP 200 from $url after ${timeout}s (last status: ${code:-none})."
  return 1
}

# ─── Compose ─────────────────────────────────────────────────────────────────

# The Compose files of the instance: COMPOSE_FILE in .env (docker-compose.yml,
# plus docker-compose.proxy.yml for an instance served by the shared proxy),
# always given explicitly so that Compose never looks for another file in the
# parent directories.
compose() {
  local list f files=()
  list=$(env_get COMPOSE_FILE)
  IFS=: read -ra list <<<"${list:-docker-compose.yml}"
  for f in "${list[@]}"; do
    [[ $f == /* ]] || f="$INSTALL_DIR/$f"
    files+=(-f "$f")
  done
  docker compose --project-directory "$INSTALL_DIR" "${files[@]}" "$@"
}
# compose_at VERSION … — Compose with another image version (the .env is untouched)
compose_at() { local v=$1; shift; HUMBLE_VERSION=$v compose "$@"; }

db_builtin() { [[ ",$(env_get COMPOSE_PROFILES)," == *,db,* ]]; }
image_repo() { local r; r=$(env_get HUMBLE_IMAGE); printf '%s' "${r:-$DEFAULT_IMAGE_REPO}"; }
proxy_repo() {
  local r; r=$(penv_get HUMBLE_CADDY_IMAGE)
  [ -n "$r" ] || r=$(env_get HUMBLE_CADDY_IMAGE)
  printf '%s' "${r:-$DEFAULT_CADDY_REPO}"
}

state_set() { # state_set "result text"
  printf 'last_check=%s\nlast_result=%s\n' "$(date '+%F %T')" "$1" >"$STATE_FILE.tmp" && mv -f "$STATE_FILE.tmp" "$STATE_FILE"
}
state_get() { [ -r "$STATE_FILE" ] && sed -n "s/^$1=//p" "$STATE_FILE" | sed -n 1p; return 0; }

# result STATUS DETAIL — outcome of an update, read by `update` with several instances
result() { [ -z "$RESULT_FILE" ] || printf '%s\t%s\n' "$1" "${2:-}" >"$RESULT_FILE"; return 0; }

# ─── Backups ─────────────────────────────────────────────────────────────────

# backup_to FILE — pg_dump through the app image (custom format)
backup_to() {
  local file=$1
  ( umask 077; compose run --rm -T --no-deps app provision backup >"$file.part" )
  [ "$(head -c 5 "$file.part" 2>/dev/null)" = "PGDMP" ] || { echo "The backup is empty or invalid."; return 1; }
  mv -f "$file.part" "$file"
  chmod 600 "$file"
}

rotate_backups() {
  find "$BACKUP_DIR" -maxdepth 1 -name 'pre-update-*.dump' -printf '%T@ %p\n' 2>/dev/null |
    sort -rn | awk -v keep="$KEEP_PRE_UPDATE_BACKUPS" 'NR > keep { print $2 }' | xargs -r rm -f
}

restore_from() {
  compose run --rm -T --no-deps app provision restore <"$1"
}

cmd_backup() {
  take_lock
  install -d -m 0700 "$BACKUP_DIR"
  local file
  file="$BACKUP_DIR/manual-$(env_get HUMBLE_VERSION)-$(date +%Y%m%d-%H%M%S).dump"
  db_builtin && { compose up -d --wait db >>"$UPDATE_LOG" 2>&1 || true; }
  spin "Backing up the database of $NAME" backup_to "$file" || { last_log_lines 10; die "Backup failed."; }
  info "Backup: $file ($(du -h "$file" | cut -f1))"
}

# ─── Releases ────────────────────────────────────────────────────────────────

# Parses the GitHub releases JSON (stdin) with Bun inside the app image: no jq
# needed on the host. Prints LATEST / TARGET / NOTE* lines, or ERR.
read -r -d '' RELEASES_JS <<'JS' || true
const say = (...f) => console.log(f.join("\t"));
let data;
try { data = JSON.parse(await Bun.stdin.text()); } catch { say("ERR", "The release information is not valid JSON."); process.exit(1); }
if (!Array.isArray(data)) { say("ERR", data && data.message ? `Release server: ${data.message}` : "Unexpected release information."); process.exit(1); }
const parse = (t) => { const m = /^v?(\d+)\.(\d+)\.(\d+)$/.exec(String(t ?? "").trim()); return m ? m.slice(1, 4).map(Number) : null; };
const cmp = (a, b) => a[0] - b[0] || a[1] - b[1] || a[2] - b[2];
const str = (v) => v.join(".");
const env = process.env;
const cur = parse(env.CURRENT);
if (!cur) { say("ERR", `The installed version "${env.CURRENT}" is not a release number.`); process.exit(1); }
const rel = data.filter((r) => r && !r.draft && !r.prerelease)
  .map((r) => ({ v: parse(r.tag_name), r })).filter((x) => x.v).sort((a, b) => cmp(b.v, a.v));
if (rel.length === 0) { say("ERR", "No published release found."); process.exit(1); }
const latest = rel[0];
const kind = cmp(latest.v, cur) <= 0 ? "none" : latest.v[0] !== cur[0] ? "major" : latest.v[1] !== cur[1] ? "minor" : "patch";
say("LATEST", str(latest.v), kind);
let target = latest;
if (env.MODE === "version") {
  const want = parse(env.WANT);
  if (!want) { say("ERR", `"${env.WANT}" is not a version number (expected X.Y.Z).`); process.exit(1); }
  target = rel.find((x) => cmp(x.v, want) === 0);
  if (!target) { say("ERR", `Release v${str(want)} was not found.`); process.exit(1); }
  if (cmp(target.v, cur) < 0) { say("ERR", `v${str(want)} is older than the installed version v${str(cur)}: use "humble-planning rollback".`); process.exit(1); }
} else if (env.MODE === "auto") {
  target = rel.find((x) => x.v[0] === cur[0] && x.v[1] === cur[1]);
}
if (!target || cmp(target.v, cur) <= 0) process.exit(0);
const day = (r) => String(r.published_at ?? "").slice(0, 10);
say("TARGET", str(target.v), target.r.tag_name, day(target.r), target.r.html_url ?? "");

// Release notes of every version after the installed one, Markdown → text.
const width = Math.max(48, Math.min(Number(env.COLS) || 80, 100) - 8);
const inline = (s) => s.replace(/<!--[\s\S]*?-->/g, "").replace(/!\[[^\]]*\]\([^)]*\)/g, "")
  .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1").replace(/\*\*([^*]+)\*\*|__([^_]+)__/g, (_, a, b) => a ?? b)
  .replace(/`([^`]+)`/g, "$1").replace(/<\/?[a-z][^>]*>/gi, "").trim();
const wrap = (text, first, next) => {
  const out = []; let line = first;
  for (const word of text.split(/\s+/).filter(Boolean)) {
    if (line.trim() && (line + word).length > width) { out.push(line.trimEnd()); line = next; }
    line += word + " ";
  }
  if (line.trim()) out.push(line.trimEnd());
  return out;
};
const MAX = 30; let count = 0; let truncated = false;
const emit = (tag, text) => { if (count >= MAX) { truncated = true; return; } say(tag, text); count++; };
for (const x of rel.filter((x) => cmp(x.v, cur) > 0 && cmp(x.v, target.v) <= 0)) {
  const name = x.r.name && x.r.name !== x.r.tag_name ? ` — ${inline(x.r.name)}` : "";
  emit("NOTEH", `v${str(x.v)}${day(x.r) ? " (" + day(x.r) + ")" : ""}${name}`);
  let blank = false;
  for (const raw of String(x.r.body ?? "").replace(/\r/g, "").split("\n")) {
    const heading = /^#{1,6}\s+(.*)$/.exec(raw);
    const bullet = /^(\s*)[-*+]\s+(.*)$/.exec(raw);
    if (!raw.trim()) { if (!blank && count) emit("NOTE", ""); blank = true; continue; }
    blank = false;
    if (heading) emit("NOTES", inline(heading[1]));
    else if (bullet) {
      const pad = "  ".repeat(Math.min(3, Math.floor(bullet[1].length / 2)));
      for (const l of wrap(inline(bullet[2]), `${pad}• `, `${pad}  `)) emit("NOTE", l);
    } else for (const l of wrap(inline(raw), "", "")) emit("NOTE", l);
  }
}
if (truncated) say("NOTE", `… Full release notes: ${target.r.html_url ?? latest.r.html_url ?? ""}`);
JS

# fetch_releases FILE — the release list, downloaded once per source and run
fetch_releases() {
  local src repo cache
  src=${HUMBLE_UPDATE_SOURCE:-$(env_get HUMBLE_UPDATE_SOURCE)}
  repo=$(env_get HUMBLE_UPDATE_REPO)
  [ -n "$src" ] || src="https://api.github.com/repos/${repo:-$DEFAULT_UPDATE_REPO}/releases?per_page=100"
  cache="$TMP_DIR/releases-$(printf '%s' "$src" | cksum | cut -d' ' -f1).json"
  if [ ! -s "$cache" ]; then
    log "FETCH $src"
    curl -fsSL --max-time 30 -H 'Accept: application/vnd.github+json' -H 'User-Agent: humble-planning-updater' "$src" >"$cache.part" || return 1
    mv -f "$cache.part" "$cache"
  fi
  cp "$cache" "$1"
}

# fetch_and_parse MODE WANT → $REL_OUT (runs in a subshell under spin)
fetch_and_parse() {
  local mode=$1 want=${2:-} current json="$TMP_DIR/releases.$NAME.json" out=$REL_OUT
  current=$(env_get HUMBLE_VERSION)
  if ! fetch_releases "$json" 2>>"$UPDATE_LOG"; then
    echo "Could not download the release list (network, GitHub API rate limit or HUMBLE_UPDATE_SOURCE)." >"$out"
    return 1
  fi
  docker run --rm -i --network none --entrypoint bun \
    --env "CURRENT=$current" --env "MODE=$mode" --env "WANT=$want" --env "COLS=${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}" \
    "$(image_repo):$current" -e "$RELEASES_JS" <"$json" >"$out" 2>>"$UPDATE_LOG" || true
  if grep -q $'^ERR\t' "$out"; then sed -n $'s/^ERR\t//p' "$out" | sed -n 1p >"$out.err"; mv "$out.err" "$out"; return 1; fi
  if ! grep -q $'^LATEST\t' "$out"; then echo "Could not read the release list (see $UPDATE_LOG)." >"$out"; return 1; fi
}

# load_release_vars → LATEST, LATEST_KIND, TARGET, TARGET_DATE, TARGET_URL, NOTES
load_release_vars() {
  local out=$REL_OUT
  IFS=$'\t' read -r _ LATEST LATEST_KIND < <(grep $'^LATEST\t' "$out")
  TARGET="" TARGET_DATE="" TARGET_URL=""
  if grep -q $'^TARGET\t' "$out"; then
    IFS=$'\t' read -r _ TARGET _ TARGET_DATE TARGET_URL < <(grep $'^TARGET\t' "$out")
  fi
  NOTES="$out"
}

print_notes() {
  local tag text
  say ""
  say "  ${BOLD}Release notes${RESET}"
  while IFS=$'\t' read -r tag text; do
    case "$tag" in
      NOTEH) say ""; say "  ${ACCENT}${BOLD}$text${RESET}" ;;
      NOTES) say "    ${BOLD}$text${RESET}" ;;
      NOTE) say "    $text" ;;
    esac
  done <"$NOTES"
  if [ -n "$TARGET_URL" ]; then say ""; say "  ${DIM}Release page: $TARGET_URL${RESET}"; fi
}

# ─── Scripts of the release ──────────────────────────────────────────────────

# release_file TAG PATH DEST — a file of the repository (deploy/…) at TAG:
# the local tree of HUMBLE_BUILD_SOURCE when the images are built from a
# directory, nothing with HUMBLE_PULL=0 (offline), else downloaded.
release_file() {
  local tag=$1 rel=$2 dest=$3 src repo base
  src=$(env_get HUMBLE_BUILD_SOURCE)
  if [ -n "$src" ] && [ -d "$src" ]; then
    cp "$src/$rel" "$dest"
    return
  fi
  if [ "$(env_get HUMBLE_PULL)" = 0 ]; then
    echo "HUMBLE_PULL=0: $rel of $tag is not downloaded."
    return 1
  fi
  repo=$(env_get HUMBLE_UPDATE_REPO)
  base=${HUMBLE_SCRIPTS_URL:-"https://raw.githubusercontent.com/${repo:-$DEFAULT_UPDATE_REPO}/{tag}"}
  base=${base//\{tag\}/$tag}
  curl -fsSL --retry 2 --max-time 60 -o "$dest" "$base/$rel"
}

# Offline (HUMBLE_PULL=0, images not built from a directory): the scripts of
# the release cannot be fetched, by choice — no network access is attempted.
scripts_offline() {
  local src
  src=$(env_get HUMBLE_BUILD_SOURCE)
  [ "$(env_get HUMBLE_PULL)" = 0 ] && ! { [ -n "$src" ] && [ -d "$src" ]; }
}

# A fetched script is only used when it is complete and valid bash.
valid_bash_script() {
  [ -s "$1" ] && head -n1 "$1" | grep -qE '^#!.*[/ ]bash([[:space:]]|$)' && bash -n "$1" 2>>"$UPDATE_LOG"
}

highest_installed() {
  local n
  for n in $(instance_names); do instance_version "$n"; echo; done | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -n1
}

# self_target MODE WANT INSTANCE → the release tag `update` moves to (empty
# when unknown): --version, the latest release, or for --auto the latest
# patch release of the series of the instance.
self_target() {
  local mode=$1 want=${2#v} name=$3 json="$TMP_DIR/self-releases.json" cur
  if [ "$mode" = version ]; then
    if [[ $want =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then printf 'v%s' "$want"; fi
    return 0
  fi
  ( ENV_FILE="$(reg_get "$name" DIR)/.env"; fetch_releases "$json" ) 2>>"$UPDATE_LOG" || return 0
  if [ "$mode" = auto ]; then
    cur=$(instance_version "$name")
    release_tags <"$json" | grep -E "^v?${cur%.*}\.[0-9]+$" | tail -n1 || true
  else
    release_tags <"$json" | tail -n1
  fi
}

# self_update TAG INSTANCE — before any instance is touched, the installed
# command is replaced by the one of TAG when it differs, then run again with
# the same arguments (HUMBLE_SELF_UPDATED: once). Never with a release older
# than the newest version installed here, or older than SELF_UPDATE_MIN (an
# older command may not know several instances). A failure only warns: the
# update goes on with the current command.
self_update() {
  local tag=$1 v max new="$TMP_DIR/humble-planning.new"
  v=${tag#v}
  [ -z "${HUMBLE_SELF_UPDATED:-}" ] && [ -n "$tag" ] && [ "$SELF" = "$WRAPPER_PATH" ] || return 0
  [[ $v =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 0
  if version_gt "$SELF_UPDATE_MIN" "$v"; then return 0; fi
  max=$(highest_installed)
  if [ -n "$max" ] && version_gt "$max" "$v"; then return 0; fi
  if ( ENV_FILE="$(reg_get "$2" DIR)/.env"; scripts_offline ); then
    log "SELF  HUMBLE_PULL=0: the command of $tag is not fetched (offline)"
    return 0
  fi
  if ! ( ENV_FILE="$(reg_get "$2" DIR)/.env"; release_file "$tag" deploy/humble-planning "$new" ) >>"$UPDATE_LOG" 2>&1; then
    warn "The humble-planning command of $tag could not be fetched: the update goes on with the current one (see $UPDATE_LOG)."
    return 0
  fi
  cmp -s "$new" "$SELF" && return 0
  if ! valid_bash_script "$new"; then
    warn "The humble-planning command of $tag is not a valid script: the update goes on with the current one."
    return 0
  fi
  cp -p "$SELF" "$SELF.prev"
  install -m 0755 "$new" "$SELF.new"
  mv -f "$SELF.new" "$SELF"
  ok "humble-planning command updated to the one of $tag (previous one: $SELF.prev)"
  log "SELF  $tag installed, running it again: humble-planning ${ORIG_ARGS[*]}"
  # exec skips the EXIT trap: clean up first.
  spinner_stop
  rm -rf -- "${TMP_DIR:?}"
  HUMBLE_SELF_UPDATED=$tag exec "$SELF" "${ORIG_ARGS[@]}"
}

# Compose files of the selected instance (COMPOSE_FILE in .env)
instance_compose_files() {
  echo docker-compose.yml
  if proxied; then echo docker-compose.proxy.yml; fi
}

# compose_prepare TAG — the Compose files of TAG, checked (docker compose
# config) with the .env of the instance, into $TMP_DIR/compose.<name>/; only
# the files that differ from the current ones stay there.
compose_prepare() {
  local tag=$1 d="$TMP_DIR/compose.$NAME" f args=()
  rm -rf -- "${d:?}"
  mkdir -p "$d"
  for f in $(instance_compose_files); do
    release_file "$tag" "deploy/$f" "$d/$f" || return 1
    [ -s "$d/$f" ] || { echo "deploy/$f of $tag is empty."; return 1; }
    args+=(-f "$d/$f")
  done
  HUMBLE_VERSION=${tag#v} docker compose --project-directory "$INSTALL_DIR" "${args[@]}" config -q || return 1
  for f in $(instance_compose_files); do
    if cmp -s "$d/$f" "$INSTALL_DIR/$f"; then rm -f -- "${d:?}/$f"; else echo "$f changes in $tag"; fi
  done
}

# compose_install FROM — installs the prepared files: the current ones are
# kept as <file>.bak-<date> (as install.sh does) and in backups/compose-vFROM/
# for the rollback.
COMPOSE_CHANGED=0
compose_install() {
  local from=$1 d="$TMP_DIR/compose.$NAME" f keep="$BACKUP_DIR/compose-v$1" stamp
  stamp=$(date +%Y%m%d%H%M%S)
  for f in "$d"/*; do
    [ -f "$f" ] || continue
    f=${f##*/}
    install -d -m 0700 "$keep"
    if [ -f "$INSTALL_DIR/$f" ]; then
      cp -p "$INSTALL_DIR/$f" "$keep/$f"
      cp -p "$INSTALL_DIR/$f" "$INSTALL_DIR/$f.bak-$stamp"
    fi
    install -m 0640 "$d/$f" "$INSTALL_DIR/$f"
    COMPOSE_CHANGED=1
  done
}

# compose_restore VERSION — the Compose files kept when VERSION was updated
compose_restore() {
  local keep="$BACKUP_DIR/compose-v$1" f
  [ -d "$keep" ] || return 0
  for f in "$keep"/*; do
    [ -f "$f" ] || continue
    install -m 0640 "$f" "$INSTALL_DIR/${f##*/}"
  done
}

# ─── Update ──────────────────────────────────────────────────────────────────

# pull_or_build VERSION — images of the instance. The image of the shared proxy
# is fetched too; it is optional (the proxy keeps its version without it).
pull_or_build() {
  local v=$1 src
  src=$(env_get HUMBLE_BUILD_SOURCE)
  if [ -n "$src" ]; then
    local ref=$src
    [ -d "$src" ] || ref="${src%%#*}#v$v"
    docker build --pull -t "$(image_repo):$v" --build-arg "APP_VERSION=$v" "$ref"
    if proxied; then
      if [ -d "$src" ]; then docker build -t "$(proxy_repo):$v" "$src/deploy/caddy" || true; else docker build -t "$(proxy_repo):$v" "$ref:deploy/caddy" || true; fi
    fi
  elif [ "$(env_get HUMBLE_PULL)" = 0 ]; then
    docker image inspect "$(image_repo):$v" >/dev/null
    echo "Using the local images of v$v (HUMBLE_PULL=0)"
  else
    compose_at "$v" pull app socket
    if proxied; then docker pull "$(proxy_repo):$v" || echo "The image of the shared proxy could not be downloaded: the proxy keeps its version."; fi
  fi
}

# Automatic rollback after a failed update: previous version + database restore.
auto_rollback() { # auto_rollback FROM TO STAGE BACKUP MIGRATED
  local from=$1 to=$2 stage=$3 backup=$4 migrated=$5 failure="$TMP_DIR/failure.$NAME.log"
  # What went wrong: output of the failed step, then the logs of v$to.
  tail -n 6 "$UPDATE_LOG" | grep -v '^[0-9-]* [0-9:]* ' >"$failure" || true
  compose_at "$to" ps -a --format '{{.Service}}: {{.Status}}' app socket >>"$failure" 2>/dev/null || true
  compose_at "$to" logs --no-color --no-log-prefix --tail 6 app >>"$failure" 2>&1 || true
  cat "$failure" >>"$UPDATE_LOG"
  title "Rolling back $NAME to v$from"
  spin "Stopping v$to" compose stop app socket || true
  if [ "$COMPOSE_CHANGED" = 1 ]; then
    compose_restore "$from"
    ok "Compose files of v$from restored"
  fi
  local restored=1
  if [ "$migrated" = 1 ]; then
    if spin "Restoring the database from the pre-update backup" restore_from "$backup"; then restored=1; else restored=0; fi
  fi
  if ! spin "Starting v$from again" compose up -d --wait --wait-timeout 180; then
    last_log_lines 20
    result failed "update to v$to failed ($stage), and v$from did not start again"
    die "The rollback could not restart v$from: check 'humble-planning logs $NAME'. Backup: $backup"
  fi
  state_set "Update to v$to failed ($stage); rolled back to v$from"
  result rolledback "v$from (update to v$to failed while $stage)"
  say ""
  bad "${BOLD}The update of $NAME to v$to failed while $stage.${RESET}"
  ok "$NAME is running v$from again."
  if [ "$migrated" = 1 ] && [ "$restored" = 1 ]; then ok "The database was restored from the backup taken before the update."; fi
  if [ "$restored" = 0 ]; then bad "The database could not be restored automatically: restore it with 'humble-planning rollback $NAME'."; fi
  info "Backup: $backup"
  excerpt "$failure" 14 "What went wrong (full log: $UPDATE_LOG):"
  exit 1
}

do_update() { # do_update FROM TO
  local from=$1 to=$2 backup migrated=0
  local app_port
  app_port=$(env_get HP_APP_PORT)

  title "Updating $NAME: Humble Planning v$from → v$to"
  if ! spin "Downloading v$to" pull_or_build "$to"; then
    state_set "Update to v$to failed (download); nothing changed"
    result failed "download of v$to failed; v$from still running"
    last_log_lines 15
    die "Could not get the images of v$to: nothing was changed, v$from is still running."
  fi
  # The Compose files of v$to, checked before anything stops. Without them
  # (offline, network), the current ones are kept.
  local compose_ok=0
  if scripts_offline; then
    info "HUMBLE_PULL=0 (offline): the current Compose files are kept."
  elif spin "Fetching the Compose files of v$to" compose_prepare "v$to"; then
    compose_ok=1
  else
    warn "The Compose files of v$to could not be fetched or checked: the current ones are kept (see $UPDATE_LOG)."
  fi

  spin "Stopping the application for the update" compose stop app socket || true
  install -d -m 0700 "$BACKUP_DIR"
  backup="$BACKUP_DIR/pre-update-$from-to-$to-$(date +%Y%m%d-%H%M%S).dump"
  if ! spin "Backing up the database" backup_to "$backup"; then
    rm -f "$backup.part"
    compose up -d --wait --wait-timeout 180 >>"$UPDATE_LOG" 2>&1 || true
    state_set "Update to v$to cancelled: backup failed"
    result failed "backup failed: update cancelled, v$from restarted"
    last_log_lines 15
    die "The database backup failed: update cancelled, v$from restarted."
  fi
  info "Backup: $backup ($(du -h "$backup" | cut -f1))"
  rotate_backups

  if [ "$compose_ok" = 1 ]; then
    compose_install "$from"
    if [ "$COMPOSE_CHANGED" = 1 ]; then info "Compose files of v$to installed (those of v$from kept in $BACKUP_DIR/compose-v$from)"; fi
  fi
  migrated=1
  if ! spin "Applying the database migrations of v$to" compose_at "$to" run --rm -T --no-deps app provision migrate; then
    auto_rollback "$from" "$to" "applying the database migrations" "$backup" "$migrated"
  fi
  if ! spin "Starting v$to" compose_at "$to" up -d --wait --wait-timeout 180; then
    auto_rollback "$from" "$to" "starting the new version (health check)" "$backup" "$migrated"
  fi
  if ! spin "Checking the web application" wait_http "http://127.0.0.1:${app_port:-3000}/login" 90; then
    auto_rollback "$from" "$to" "checking the web application" "$backup" "$migrated"
  fi

  env_set HUMBLE_PREVIOUS_VERSION "$from" HUMBLE_VERSION "$to"
  state_set "Updated v$from → v$to"
  result updated "v$from → v$to"
  say ""
  ok "${BOLD}$NAME: Humble Planning v$to is up and running.${RESET}"
  info "Previous version v$from kept for 'humble-planning rollback $NAME'."
  info "Pre-update backup: $backup"
}

# update_instance MODE WANT YES — update of the selected instance (checks the
# releases, shows the notes unless QUIET_NOTES=1, asks unless YES=1).
QUIET_NOTES=0
update_instance() {
  local mode=$1 want=$2 yes=$3 current
  take_lock
  current=$(env_get HUMBLE_VERSION)
  [ -n "$current" ] || { result failed "HUMBLE_VERSION missing"; die "HUMBLE_VERSION is missing from $ENV_FILE."; }

  if ! spin "Checking for updates of $NAME (installed: v$current)" fetch_and_parse "$mode" "$want"; then
    state_set "Update check failed: $(cat "$REL_OUT" 2>/dev/null)"
    result failed "update check: $(cat "$REL_OUT" 2>/dev/null)"
    die "$(cat "$REL_OUT" 2>/dev/null || echo "Update check failed (see $UPDATE_LOG).")"
  fi
  load_release_vars

  if [ -z "$TARGET" ]; then
    if [ "$AUTO" = 1 ] && [ "$LATEST_KIND" != none ]; then
      info "v$LATEST is available ($LATEST_KIND update): not applied automatically. Run: humble-planning update $NAME"
      state_set "Up to date in the v${current%.*}.x series; v$LATEST available ($LATEST_KIND, manual update)"
    else
      state_set "Already up to date (v$current)"
    fi
    result uptodate "v$current"
    ok "$NAME is already up to date (v$current)"
    return 0
  fi

  ok "New version available for $NAME: ${BOLD}v$TARGET${RESET}${TARGET_DATE:+ (released $TARGET_DATE)}"
  [ "$QUIET_NOTES" = 1 ] || print_notes
  [ "$yes" = 1 ] || say ""
  if [ "$yes" = 0 ] && ! confirm "Update $NAME from v$current to v$TARGET? A database backup is taken first." y; then
    result cancelled "v$current"
    quit "Update cancelled: nothing was changed."
  fi
  do_update "$current" "$TARGET"
}

# read_check NAME → C_STATUS C_CURRENT C_TARGET (result of check_one)
# (Fields separated by "|": with a tab, read would merge an empty target.)
read_check() {
  local rest=""
  C_STATUS=ERR C_CURRENT="no result (see $LOG_DIR/$1.log)" C_TARGET=""
  [ -f "$TMP_DIR/check.$1" ] || return 0
  IFS='|' read -r C_STATUS rest <"$TMP_DIR/check.$1" || true
  if [ "$C_STATUS" = OK ]; then IFS='|' read -r C_CURRENT C_TARGET _ <<<"$rest"; else C_CURRENT=$rest; fi
}

# check_one MODE WANT → $TMP_DIR/check.<name>: OK|current|target|latest|kind or ERR|message
check_one() {
  local out="$TMP_DIR/check.$NAME" current
  current=$(env_get HUMBLE_VERSION)
  if fetch_and_parse "$1" "$2"; then
    load_release_vars
    printf 'OK|%s|%s|%s|%s\n' "$current" "$TARGET" "$LATEST" "$LATEST_KIND" >"$out"
  else
    printf 'ERR|%s\n' "$(cat "$REL_OUT" 2>/dev/null)" >"$out"
  fi
}

check_all() { # check_all MODE WANT NAME…
  local mode=$1 want=$2 n; shift 2
  for n in "$@"; do ( select_instance "$n"; check_one "$mode" "$want" ) || true; done
}

# The shared proxy follows the newest version installed (never moves back).
proxy_follow() {
  [ -n "$1" ] && proxy_exists || return 0
  proxy_upgrade "$1" 1 || warn "The shared reverse proxy keeps v$(penv_get HUMBLE_CADDY_VERSION) (see $UPDATE_LOG)."
}

cmd_update() {
  local want="" yes=0 mode=latest all=0 a names=() targets=() n
  while [ $# -gt 0 ]; do
    case "$1" in
      --version) want=${2:-}; shift ;;
      --version=*) want=${1#*=} ;;
      -y|--yes) yes=1 ;;
      --auto) AUTO=1; yes=1 ;;
      --all) all=1 ;;
      -*) die "Unknown option for update: $1" 2 ;;
      *) is_instance "$1" || { print_instances; die "Unknown instance: $1" 2; }
         [[ " ${names[*]} " == *" $1 "* ]] || names+=("$1") ;;
    esac
    shift
  done
  [ -n "$want" ] && mode=version
  [ "$AUTO" = 1 ] && mode=auto
  check_legacy
  mapfile -t targets < <(instance_names)
  [ "${#targets[@]}" -gt 0 ] || die "No Humble Planning instance is installed on this server. Install one: $NEW_HINT"

  if [ "$AUTO" = 1 ]; then
    # The nightly timer of an instance: one instance, no questions.
    [ "${#names[@]}" -le 1 ] && [ "$all" = 0 ] || die "--auto updates one instance at a time." 2
    [ "${#names[@]}" -eq 1 ] || [ "${#targets[@]}" -eq 1 ] || die "--auto needs the instance name." 2
    select_instance "${names[0]:-${targets[0]}}"
    setup_colors
    exec >>"$UPDATE_LOG" 2>&1
    printf '\n===== %s automatic update check of %s%s\n' "$(date '+%F %T')" "$NAME" "${HUMBLE_SELF_UPDATED:+ (command of $HUMBLE_SELF_UPDATED)}"
    self_update "$(self_target auto "" "$NAME")" "$NAME"
    RESULT_FILE="$TMP_DIR/result.$NAME"
    update_instance auto "" 1
    [ "$(cut -f1 "$RESULT_FILE" 2>/dev/null)" = updated ] && proxied && proxy_follow "$(env_get HUMBLE_VERSION)"
    return 0
  fi

  # The command of the target release first: it runs again, then checks and asks.
  self_update "$(self_target "$mode" "$want" "${names[0]:-${targets[0]}}")" "${names[0]:-${targets[0]}}"

  if [ "$all" = 1 ]; then
    names=("${targets[@]}")
  elif [ "${#names[@]}" -eq 0 ] && [ "${#targets[@]}" -eq 1 ]; then
    names=("${targets[0]}")
  elif [ "${#names[@]}" -eq 0 ] && ! interactive; then
    print_instances
    say ""
    die "Several instances are installed: name them (humble-planning update ${targets[0]} …) or use --all." 2
  fi

  if [ "${#names[@]}" -eq 1 ]; then
    # One instance: release notes and confirmation, as always.
    select_instance "${names[0]}"
    RESULT_FILE="$TMP_DIR/result.$NAME"
    update_instance "$mode" "$want" "$yes"
    [ "$(cut -f1 "$RESULT_FILE" 2>/dev/null)" = updated ] && proxied && proxy_follow "$(env_get HUMBLE_VERSION)"
    return 0
  fi
  # Exit code 1 when an instance failed or was rolled back (see the summary).
  update_many "$mode" "$want" "$yes" "${names[@]}" || exit 1
}

# update_many MODE WANT YES [NAME…] — no name: chosen in the terminal
update_many() {
  local mode=$1 want=$2 yes=$3 n status detail ans picked=() todo=() lowest="" rc=0 v best=""
  local -a pool; local ok_input w; shift 3
  if [ $# -gt 0 ]; then pool=("$@"); else mapfile -t pool < <(instance_names); fi
  spin "Checking for updates (${#pool[@]} instances)" check_all "$mode" "$want" "${pool[@]}" || true

  EXTRA=([__header]="UPDATE")
  for n in "${pool[@]}"; do
    read_check "$n"
    if [ "$C_STATUS" = OK ] && [ -n "$C_TARGET" ]; then EXTRA[$n]="${GREEN}v$C_CURRENT → v$C_TARGET${RESET}"
    elif [ "$C_STATUS" = OK ]; then EXTRA[$n]="${DIM}v$C_CURRENT, up to date${RESET}"
    else EXTRA[$n]="${RED}check failed: $C_CURRENT${RESET}"
    fi
  done

  if [ $# -eq 0 ]; then
    # Picker: numbers or names, "all" = every instance with an update
    say ""
    say "  ${BOLD}Humble Planning instances on this server${RESET}"
    print_instances 1
    while :; do
      printf '\n  %s?%s Instances to update: numbers or names separated by spaces, "all" %s[all]%s ' "$ACCENT" "$RESET" "$DIM" "$RESET"
      IFS= read -r ans </dev/tty || die "No input available." 2
      ans=${ans:-all}
      picked=()
      if [ "${ans,,}" = all ]; then picked=("${pool[@]}"); break; fi
      ok_input=1
      for w in ${ans//,/ }; do
        if [[ $w =~ ^[0-9]+$ ]] && [ "$w" -ge 1 ] && [ "$w" -le "${#pool[@]}" ]; then w=${pool[w - 1]}
        elif ! is_instance "$w"; then ok_input=0; break
        fi
        [[ " ${picked[*]} " == *" $w "* ]] || picked+=("$w")
      done
      [ "$ok_input" = 1 ] && [ "${#picked[@]}" -gt 0 ] && break
      printf '    %s✖ Enter numbers between 1 and %d, instance names, or "all".%s\n' "$RED" "${#pool[@]}" "$RESET"
    done
  else
    picked=("${pool[@]}")
    print_instances_subset "${picked[@]}"
  fi

  # Instances with an update; the release notes are those of the oldest one.
  for n in "${picked[@]}"; do
    read_check "$n"
    if [ "$C_STATUS" = OK ] && [ -n "$C_TARGET" ]; then
      todo+=("$n")
      if [ -z "$lowest" ] || version_gt "$(instance_version "$lowest")" "$C_CURRENT"; then lowest=$n; fi
    fi
  done
  if [ "${#todo[@]}" -eq 0 ]; then
    say ""
    ok "Nothing to update: the selected instances are up to date (or their check failed, see above)."
    for n in "${picked[@]}"; do read_check "$n"; [ "$C_STATUS" = OK ] || rc=1; done
    return "$rc"
  fi
  if [ "$yes" = 0 ]; then
    NOTES="$TMP_DIR/releases.$lowest.out"
    TARGET_URL=$(grep $'^TARGET\t' "$NOTES" | cut -f5)
    print_notes
    say ""
    confirm "Update ${#todo[@]} instance(s) (${todo[*]}), one after the other? A database backup of each one is taken first." y ||
      quit "Update cancelled: nothing was changed."
  fi

  # One after the other, each in its own subshell: a failure (and its
  # rollback) stays with its instance.
  for n in "${picked[@]}"; do
    RESULT_FILE="$TMP_DIR/result.$n"
    : >"$RESULT_FILE"
    if [[ " ${todo[*]} " == *" $n "* ]]; then
      ( select_instance "$n"; QUIET_NOTES=1; update_instance "$mode" "$want" 1 ) || true
    else
      read_check "$n"
      if [ "$C_STATUS" = OK ]; then result uptodate "v$C_CURRENT"; else result failed "update check: $C_CURRENT"; fi
    fi
    if [ "$(cut -f1 "$RESULT_FILE")" = updated ] && proxied "$n"; then
      v=$(instance_version "$n")
      if [ -z "$best" ] || version_gt "$v" "$best"; then best=$v; fi
    fi
  done
  RESULT_FILE=""
  [ -z "$best" ] || proxy_follow "$best"

  title "Summary"
  for n in "${picked[@]}"; do
    status="" detail=""
    IFS=$'\t' read -r status detail <"$TMP_DIR/result.$n" || true
    case "$status" in
      updated) ok "$(pad "$n" 14) updated $detail" ;;
      uptodate) info "$(pad "$n" 14) already up to date ($detail)" ;;
      rolledback) bad "$(pad "$n" 14) rolled back to $detail"; rc=1 ;;
      cancelled) info "$(pad "$n" 14) cancelled ($detail)" ;;
      failed) bad "$(pad "$n" 14) failed: $detail"; rc=1 ;;
      *) bad "$(pad "$n" 14) failed: unexpected error (see $LOG_DIR/$n.log)"; rc=1 ;;
    esac
  done
  say ""
  return "$rc"
}

print_instances_subset() { # the table, limited to the instances given
  local n keep=" $* "
  for n in $(instance_names); do [[ $keep == *" $n "* ]] || EXTRA[$n]="${DIM}(not selected)${RESET}"; done
  print_instances
}

# ─── Rollback ────────────────────────────────────────────────────────────────

cmd_rollback() {
  local yes=0 restore="" current previous backup=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -y|--yes) yes=1 ;;
      --restore) restore=1 ;;
      --no-restore) restore=0 ;;
      *) die "Unknown option for rollback: $1" 2 ;;
    esac
    shift
  done
  take_lock
  current=$(env_get HUMBLE_VERSION)
  previous=$(env_get HUMBLE_PREVIOUS_VERSION)
  [ -n "$previous" ] || die "No previous version recorded for $NAME: nothing to roll back to."
  backup=$(find "$BACKUP_DIR" -maxdepth 1 -name "pre-update-$previous-to-$current-*.dump" -printf '%T@ %p\n' 2>/dev/null | sort -rn | awk 'NR == 1 { print $2 }')

  title "Rolling back $NAME: Humble Planning v$current → v$previous"
  if [ "$yes" = 0 ] && ! confirm "Roll back $NAME to v$previous?" y; then quit "Rollback cancelled: nothing was changed."; fi

  if [ -n "$backup" ] && [ -z "$restore" ]; then
    say ""
    warn "${BOLD}Database:${RESET} a backup was taken just before the update to v$current:"
    say "      $backup"
    warn "Restoring it brings the data back to $(date -r "$backup" '+%F %T'): ${BOLD}everything entered since then will be lost.${RESET}"
    say "      Without it, v$previous runs on the database as migrated by v$current."
    restore=0
    if [ "$yes" = 0 ] && confirm "Restore this backup?" n; then restore=1; fi
  elif [ "$restore" = 1 ] && [ -z "$backup" ]; then
    die "No pre-update backup found for v$previous → v$current."
  fi

  if [ "$(env_get HUMBLE_PULL)" != 0 ] && [ -z "$(env_get HUMBLE_BUILD_SOURCE)" ]; then
    spin "Downloading v$previous" compose_at "$previous" pull app socket || die "Could not get the images of v$previous."
  fi
  spin "Stopping v$current" compose stop app socket || true
  # The Compose files of v$previous, kept when v$current was installed
  if [ -d "$BACKUP_DIR/compose-v$previous" ]; then
    compose_restore "$previous"
    ok "Compose files of v$previous restored"
  fi
  if [ "${restore:-0}" = 1 ]; then
    if ! spin "Restoring the database from the pre-update backup" restore_from "$backup"; then
      compose up -d --wait --wait-timeout 180 >>"$UPDATE_LOG" 2>&1 || true
      last_log_lines 15
      die "The database restore failed: v$current restarted, nothing changed."
    fi
  fi
  if ! spin "Starting v$previous" compose_at "$previous" up -d --wait --wait-timeout 180; then
    last_log_lines 20
    die "v$previous did not start: check 'humble-planning logs $NAME'."
  fi
  env_set HUMBLE_VERSION "$previous" HUMBLE_PREVIOUS_VERSION "$current"
  state_set "Rolled back v$current → v$previous$([ "${restore:-0}" = 1 ] && echo ' (database restored)')"
  say ""
  ok "${BOLD}$NAME: Humble Planning v$previous is running.${RESET}"
  info "Run 'humble-planning update $NAME' to go back to the latest version."
}

# ─── Automatic updates ───────────────────────────────────────────────────────

timer_name() { printf '%s@%s.timer' "$UNIT" "$NAME"; }
cron_file() { printf '%s-%s' "$CRON_PREFIX" "$NAME"; }

auto_update_state() { # → systemd | cron | off (for the selected instance)
  if [ -e "$SYSTEMD_DIR/timers.target.wants/$(timer_name)" ]; then echo systemd
  elif [ -f "$(cron_file)" ]; then echo cron
  else echo off
  fi
}

# The single timer (or cron entry) of the 1.0.x installations updated the only
# instance without naming it: replaced by the timer of the instance.
remove_legacy_auto_update() {
  if [ -f "$SYSTEMD_DIR/$LEGACY_UNIT.timer" ]; then
    systemctl disable --now "$LEGACY_UNIT.timer" >/dev/null 2>&1 || true
    rm -f "$SYSTEMD_DIR/$LEGACY_UNIT.timer" "$SYSTEMD_DIR/$LEGACY_UNIT.service"
    systemctl daemon-reload 2>/dev/null || true
  fi
  rm -f "$CRON_PREFIX"
}

auto_update_off() {
  if [ -e "$SYSTEMD_DIR/timers.target.wants/$(timer_name)" ] || [ -f "$SYSTEMD_DIR/$UNIT@.timer" ]; then
    systemctl disable --now "$(timer_name)" >/dev/null 2>&1 || true
    rm -f "$SYSTEMD_DIR/timers.target.wants/$(timer_name)"
  fi
  rm -f "$(cron_file)"
  # The template units go with the last instance that used them.
  if ! compgen -G "$SYSTEMD_DIR/timers.target.wants/$UNIT@*.timer" >/dev/null && [ -f "$SYSTEMD_DIR/$UNIT@.timer" ]; then
    rm -f "$SYSTEMD_DIR/$UNIT@.timer" "$SYSTEMD_DIR/$UNIT@.service"
    systemctl daemon-reload 2>/dev/null || true
  fi
}

cmd_auto_update() {
  case "${1:-status}" in
    on|enable)
      remove_legacy_auto_update
      if [ -d /run/systemd/system ]; then
        cat >"$SYSTEMD_DIR/$UNIT@.service" <<EOF
[Unit]
Description=Humble Planning automatic update of the instance %i (patch releases only)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=$SELF update %i --auto --yes
EOF
        cat >"$SYSTEMD_DIR/$UNIT@.timer" <<EOF
[Unit]
Description=Nightly update check of the Humble Planning instance %i

[Timer]
OnCalendar=*-*-* 02:00:00
RandomizedDelaySec=3h
Persistent=true

[Install]
WantedBy=timers.target
EOF
        systemctl daemon-reload
        systemctl enable --now "$(timer_name)" >/dev/null
        ok "Automatic updates of $NAME enabled (systemd timer $(timer_name), every night between 02:00 and 05:00)"
      else
        local minute=$((RANDOM % 60)) hour=$((2 + RANDOM % 3))
        install -d -m 0755 "$(dirname "$(cron_file)")"
        cat >"$(cron_file)" <<EOF
# Humble Planning — nightly automatic update of the instance $NAME (patch releases only).
# Managed by: humble-planning auto-update on|off $NAME
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
$minute $hour * * * root $SELF update $NAME --auto --yes >/dev/null 2>&1
EOF
        chmod 644 "$(cron_file)"
        ok "Automatic updates of $NAME enabled (cron, every night at $(printf '%02d:%02d' "$hour" "$minute"))"
        if ! command -v cron >/dev/null 2>&1 && ! command -v crond >/dev/null 2>&1; then
          warn "No cron daemon is installed: install cron (apt-get install cron) for the schedule to run."
        fi
      fi
      info "Only patch releases (x.y.Z) are installed automatically; log: $UPDATE_LOG" ;;
    off|disable)
      remove_legacy_auto_update
      auto_update_off
      ok "Automatic updates of $NAME disabled" ;;
    status)
      case "$(auto_update_state)" in
        systemd)
          ok "Automatic updates of $NAME: enabled (systemd timer, patch releases only)"
          local next
          next=$(systemctl list-timers "$(timer_name)" --no-legend 2>/dev/null | awk '{print $1, $2, $3}' | sed -n 1p)
          [ -n "$next" ] && info "Next run: $next" ;;
        cron) ok "Automatic updates of $NAME: enabled (cron: $(grep -E '^[0-9]' "$(cron_file)" | awk '{printf "%02d:%02d", $2, $1}'), patch releases only)" ;;
        *) info "Automatic updates of $NAME: disabled — enable with: humble-planning auto-update on $NAME" ;;
      esac ;;
    *) die "Usage: humble-planning auto-update on|off|status [instance]" 2 ;;
  esac
  return 0
}

# ─── Demo instance ───────────────────────────────────────────────────────────

# print_prov FILE — protocol lines of `provision` (OK/INFO/WARN/ERR, tab, message)
print_prov() {
  local tag msg
  while IFS=$'\t' read -r tag msg; do
    case "$tag" in
      OK) say "    ${DIM}✔ $msg${RESET}" ;;
      INFO) say "    ${DIM}• $msg${RESET}" ;;
      WARN) say "    ${YELLOW}⚠${RESET} $msg" ;;
      ERR) say "    ${RED}✖${RESET} $msg" ;;
    esac
  done <"$1"
}

demo_reset_run() { compose run --rm -T --no-deps app provision demo-reset "$@" >"$TMP_DIR/demo-reset.out"; }

cmd_demo_reset() {
  local args=() rc=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) args=(--force) ;;
      *) die "Unknown option for demo-reset: $1" 2 ;;
    esac
    shift
  done
  [ "$(env_get DEMO_MODE)" = true ] ||
    die "$NAME is not a demo instance (DEMO_MODE=true is missing from $ENV_FILE): demo-reset would erase all the data."
  take_lock
  db_builtin && { compose up -d --wait db >>"$UPDATE_LOG" 2>&1 || true; }
  spin "Erasing the data of $NAME and loading the demo dataset" demo_reset_run "${args[@]}" || rc=$?
  print_prov "$TMP_DIR/demo-reset.out"
  if [ "$rc" = 3 ]; then
    die "Nothing was changed. To erase this data anyway: humble-planning demo-reset $NAME --force"
  elif [ "$rc" != 0 ]; then
    last_log_lines 15
    die "Could not load the demo data."
  fi
  # A new container: the application starts with empty caches (and the current .env).
  if [ -n "$(compose ps -q app 2>/dev/null || true)" ]; then
    if ! spin "Restarting the application" compose up -d --wait --wait-timeout 180 --no-deps --force-recreate app; then
      last_log_lines 15
      die "The application did not restart: check 'humble-planning logs $NAME app'."
    fi
  else
    info "The application is not running: start it with 'humble-planning start $NAME'."
  fi
}

# ─── Shared reverse proxy ────────────────────────────────────────────────────

pcompose() { docker compose --project-directory "$PROXY_DIR" -f "$PROXY_DIR/docker-compose.yml" "$@"; }
proxy_exists() { [ -f "$PROXY_DIR/docker-compose.yml" ] && [ -f "$PROXY_ENV" ]; }
proxy_running() { [ -n "$(pcompose ps -q --status running caddy 2>/dev/null)" ]; }

take_proxy_lock() {
  install -d -m 0755 "$LOCK_DIR" 2>/dev/null || true
  exec 8>"$LOCK_DIR/humble-planning-proxy.lock"
  flock -w 120 8 || die "Another humble-planning operation is changing the shared reverse proxy."
}

# The main Caddyfile: global options, then every site. Behind the Cloudflare
# proxy, CF-Connecting-IP is only read on connections from Cloudflare's ranges,
# so the option is harmless for the sites that do not use it.
proxy_render_main() {
  local n cf=()
  while IFS= read -r n; do
    [ -n "$n" ] && proxied "$n" && [ "$(reg_get "$n" CF_PROXY)" = 1 ] && [ -f "$PROXY_CONF/sites/$n.caddy" ] && cf+=("$n")
  done < <(instance_names)
  printf '# Humble Planning — shared reverse proxy, generated by humble-planning on %s.\n' "$(date '+%F %T')"
  printf '# Regenerated when a site is added or removed: edit the sites in sites/ (kept\n'
  printf '# across updates), then apply with: humble-planning proxy reload\n'
  if [ "${#cf[@]}" -gt 0 ]; then
    cat <<EOF

{
	# Served through the Cloudflare proxy: ${cf[*]}. The client address
	# ({client_ip}) is read from CF-Connecting-IP, but only on connections coming
	# from Cloudflare's IP ranges (shipped with the image, updated with each
	# release): anyone reaching this server directly cannot forge it.
	servers {
		import /etc/caddy/cloudflare-ips.caddy
		client_ip_headers CF-Connecting-IP
	}
}
EOF
  fi
  printf '\nimport sites/*.caddy\n'
}

# proxy_render_site NAME — site of an instance, from site-template.caddy
proxy_render_site() {
  local name=$1 url host blocks="" site email
  url=$(instance_url "$name")
  [[ $url =~ ^https?://([A-Za-z0-9.-]+|\[[0-9A-Fa-f:]+\])(:[0-9]+)?/?$ ]] || { echo "Invalid APP_BASE_URL for $name: $url"; return 1; }
  host=${BASH_REMATCH[1],,}
  email=$(reg_get "$name" ACME_EMAIL)
  if [ "$(reg_get "$name" TLS)" = acme ]; then
    site=$host blocks=https
    if [ "$(reg_get "$name" CF_DNS)" = 1 ]; then blocks+=",cloudflare"; elif [ -n "$email" ]; then blocks+=",acme_email"; fi
  else
    site="http://$host"
  fi
  printf '# Humble Planning — site of the instance "%s" (%s), generated by humble-planning on %s.\n' "$name" "$(reg_get "$name" LABEL)" "$(date '+%F')"
  printf '# Kept across updates. After a change: humble-planning proxy reload\n'
  awk -v keep=",$blocks," -v site="$site" -v email="$email" -v name="$name" '
    /^[[:space:]]*#@end[[:space:]]*$/ { if (depth > 0) skip = outer[depth--]; next }
    /^[[:space:]]*#@[a-z_]+[[:space:]]*$/ {
      n = $0; gsub(/[[:space:]#@]/, "", n)
      outer[++depth] = skip
      skip = skip || (index(keep, "," n ",") == 0); next
    }
    skip { next }
    /^[[:space:]]*$/ { if (blank) next; blank = 1; print ""; next }
    { blank = 0; gsub(/__SITE_ADDRESS__/, site); gsub(/__ACME_EMAIL__/, email); gsub(/__NAME__/, name); print }
  ' "$PROXY_DIR/site-template.caddy"
}

# Snapshot of the configuration (caddy/ and .env) before a change. The
# directory is mounted in the container: it is restored in place.
proxy_snapshot() {
  local d="$TMP_DIR/proxy-snapshot"
  rm -rf "$d" "$d.env"
  cp -a "$PROXY_CONF" "$d"
  cp -p "$PROXY_ENV" "$d.env"
  printf '%s' "$d"
}

proxy_restore() {
  find "$PROXY_CONF" -mindepth 1 -delete
  cp -a "$1/." "$PROXY_CONF/"
  cp -p "$1.env" "$PROXY_ENV"
}

proxy_validate() {
  if proxy_running; then
    pcompose exec -T caddy caddy validate "${CADDY_CONFIG[@]}"
  else
    pcompose run --rm --no-deps -T caddy caddy validate "${CADDY_CONFIG[@]}"
  fi
}

# Caddy answers on its admin endpoint (localhost:2019, IPv4 inside the
# container) once its configuration is loaded.
proxy_alive() {
  local i
  for ((i = 0; i < 20; i++)); do
    pcompose exec -T caddy wget -q -O /dev/null http://127.0.0.1:2019/config/ 2>/dev/null && return 0
    sleep 1
  done
  echo "The shared reverse proxy does not answer on its admin endpoint."
  return 1
}

# A stopped proxy is started in a new container: one left by a failed start
# (port taken…) can keep a broken network setup.
proxy_start() { pcompose up -d --force-recreate --wait --wait-timeout 60 && proxy_alive; }
proxy_discard() { pcompose rm --force --stop caddy >>"$UPDATE_LOG" 2>&1 || true; }
proxy_reload_running() { pcompose exec -T caddy caddy reload "${CADDY_CONFIG[@]}"; }

# Maintenance page (Caddy image 1.1.1+): each site imports the configuration
# shipped with the image. The sites made by 1.1.0 are kept across updates
# (they may have been edited by hand): only this line is added, right after
# the address of the site. A site that mentions it already (even commented
# out, to do without the page) is left as it is. An image without the file
# matches nothing, which Caddy accepts: the line can come before the image.
MAINTENANCE_IMPORT='import /etc/caddy/humble-maintenance*.caddy'

# proxy_migrate_sites → names of the sites changed (idempotent)
proxy_migrate_sites() {
  local f tmp name
  for f in "$PROXY_CONF"/sites/*.caddy; do
    [ -f "$f" ] || continue
    grep -q 'humble-maintenance' "$f" && continue
    name=${f##*/}; name=${name%.caddy}
    tmp=$(mktemp "$PROXY_CONF/sites/.$name.XXXXXX")
    if awk -v line="	$MAINTENANCE_IMPORT" '
         !done && /^[^#[:space:]].*\{[[:space:]]*$/ { print; print line; done = 1; next }
         { print }
         END { exit !done }' "$f" >"$tmp"; then
      chmod --reference="$f" "$tmp"
      mv -f "$tmp" "$f"
      printf '%s\n' "$name"
    else
      rm -f "$tmp"
    fi
  done
}

# Runs proxy_migrate_sites and tells which sites changed.
migrate_sites_note() {
  local changed
  changed=$(proxy_migrate_sites | paste -sd' ' -)
  [ -z "$changed" ] || info "Maintenance page added to the site(s) $changed (one import line, nothing else changed)"
}

# proxy_apply SNAPSHOT START — applies the files written by the caller: main
# Caddyfile generated again, checked, then hot reload (or start when START=1
# and the proxy is stopped). On failure, the snapshot is put back and the
# running configuration is kept.
proxy_apply() {
  local snap=$1 start=$2
  migrate_sites_note
  proxy_render_main >"$PROXY_CONF/Caddyfile.tmp" && mv -f "$PROXY_CONF/Caddyfile.tmp" "$PROXY_CONF/Caddyfile"
  chmod 0644 "$PROXY_CONF/Caddyfile"
  if ! spin "Checking the configuration of the shared reverse proxy" proxy_validate; then
    proxy_restore "$snap"
    last_log_lines 4
    return 1
  fi
  if proxy_running; then
    if ! spin "Reloading the shared reverse proxy (no interruption)" proxy_reload_running; then
      proxy_restore "$snap"
      last_log_lines 4
      return 1
    fi
  elif [ "$start" = 1 ]; then
    if ! spin "Starting the shared reverse proxy" proxy_start; then
      proxy_discard
      proxy_restore "$snap"
      last_log_lines 6
      return 1
    fi
  else
    info "The shared reverse proxy is stopped: the new configuration is used at its next start."
  fi
}

# proxy_check_site NAME — the proxy reaches the instance (and serves it, for a
# plain HTTP site). An HTTPS site also needs its certificate: not checked here.
proxy_check_site() {
  local name=$1 i host url
  for ((i = 0; i < 30; i++)); do
    pcompose exec -T caddy wget -q -O /dev/null "http://$name-app:3000/login" 2>/dev/null && break
    sleep 2
  done
  [ "$i" -lt 30 ] || { echo "The proxy cannot reach $name-app:3000 on the $PROXY_NETWORK network."; return 1; }
  if [ "$(reg_get "$name" TLS)" != acme ]; then
    url=$(instance_url "$name"); host=${url#*://}; host=${host%%/*}
    wait_http "http://127.0.0.1:$(penv_get HP_HTTP_PORT)/login" 30 -H "Host: $host"
  fi
}

# read_token_stdin FLAG → TOKEN (Cloudflare API token, never on the command line)
read_token_stdin() {
  TOKEN=""
  [ "$1" = 1 ] || return 0
  IFS= read -r TOKEN || true
  TOKEN=${TOKEN%$'\r'}
}

# write_site NAME — site file (and token) of an instance
write_site() {
  local name=$1 tmp
  install -d -m 0755 "$PROXY_CONF/sites"
  install -d -m 0700 "$PROXY_CONF/secrets"
  if [ "$(reg_get "$name" CF_DNS)" = 1 ]; then
    if [ -n "$TOKEN" ]; then
      ( umask 077; printf '%s\n' "$TOKEN" >"$PROXY_CONF/secrets/$name.cloudflare-token" )
    elif [ ! -s "$PROXY_CONF/secrets/$name.cloudflare-token" ]; then
      echo "The Cloudflare API token of $name is missing ($PROXY_CONF/secrets/$name.cloudflare-token)."
      return 1
    fi
  fi
  tmp=$(mktemp "$PROXY_CONF/sites/.$name.XXXXXX")
  proxy_render_site "$name" >"$tmp" || { rm -f "$tmp"; return 1; }
  chmod 0644 "$tmp"
  mv -f "$tmp" "$PROXY_CONF/sites/$name.caddy"
}

proxy_require() {
  proxy_exists || die "The shared reverse proxy is not installed in $PROXY_DIR: run the installer."
}

# proxy add-site NAME [--token-stdin] (install.sh)
cmd_proxy_add_site() {
  local name=${1:-} stdin=0 snap
  [ "${2:-}" = --token-stdin ] && stdin=1
  is_instance "$name" || die "Unknown instance: $name" 2
  select_instance "$name"
  proxied || die "$NAME is not served by the shared reverse proxy (CADDY=1 missing from $REGISTRY_DIR/$NAME.conf)."
  proxy_require
  take_proxy_lock
  read_token_stdin "$stdin"
  snap=$(proxy_snapshot)
  write_site "$NAME" || { proxy_restore "$snap"; die "Could not write the site of $NAME."; }
  proxy_apply "$snap" 1 || die "The site of $NAME was not added: the shared reverse proxy keeps its previous configuration (details: $UPDATE_LOG)."
  if ! spin "Checking $(instance_url "$NAME") through the shared reverse proxy" proxy_check_site "$NAME"; then
    last_log_lines 3
    proxy_restore "$snap"
    if proxy_running; then spin "Restoring the previous configuration of the proxy" proxy_reload_running || true; fi
    die "The shared reverse proxy cannot serve $NAME: its site was removed again (details: $UPDATE_LOG)."
  fi
  ok "Site of $NAME: $PROXY_CONF/sites/$NAME.caddy"
}

# The volume mounted at PATH in a container
volume_at() { docker inspect -f "{{range .Mounts}}{{if eq .Destination \"$2\"}}{{.Name}}{{end}}{{end}}" "$1"; }

# copy_volume FROM TO IMAGE — certificates and ACME accounts of Caddy, with
# the tools of its image (BusyBox): files already in the proxy are kept (tar
# -k, which then exits with 1), then every file of the source must be there.
read -r -d '' COPY_VOLUME_SH <<'SH' || true
tar -C /from -cf - . | tar -C /to -xkf - 2>/dev/null
cd /from && find . -type f | while IFS= read -r f; do
  [ -e "/to/$f" ] || { echo "Not copied: $f"; exit 1; }
done
SH
copy_volume() { docker run --rm --network none --entrypoint sh -v "$1:/from:ro" -v "$2:/to" "$3" -c "$COPY_VOLUME_SH"; }

# proxy adopt NAME [--token-stdin] (install.sh) — an installation made with
# 1.0.x had its own Caddy service: its site moves into the shared proxy, with
# the content of its caddy_data volume (certificates, ACME account). The old
# container is only removed once the proxy serves the site; on failure, it is
# started again and the proxy files are restored.
cmd_proxy_adopt() {
  local name=${1:-} stdin=0 snap project legacy src dst image was_running=0
  [ "${2:-}" = --token-stdin ] && stdin=1
  is_instance "$name" || die "Unknown instance: $name" 2
  select_instance "$name"
  proxy_require
  project=$(env_get COMPOSE_PROJECT_NAME)
  legacy=$(docker ps -aq --filter "label=com.docker.compose.project=$project" --filter label=com.docker.compose.service=caddy | sed -n 1p)
  if [ -z "$legacy" ]; then
    cmd_proxy_add_site "$name" "${2:-}"
    return
  fi
  take_proxy_lock
  read_token_stdin "$stdin"
  snap=$(proxy_snapshot)
  write_site "$NAME" || { proxy_restore "$snap"; die "Could not write the site of $NAME."; }
  proxy_render_main >"$PROXY_CONF/Caddyfile"
  chmod 0644 "$PROXY_CONF/Caddyfile"
  if ! spin "Checking the configuration of the shared reverse proxy" proxy_validate; then
    proxy_restore "$snap"; last_log_lines 4
    die "The configuration of the shared reverse proxy is invalid: nothing was changed, the Caddy of $NAME keeps serving it."
  fi
  image="$(proxy_repo):$(penv_get HUMBLE_CADDY_VERSION)"
  src=$(volume_at "$legacy" /data)
  proxy_running && was_running=1
  if [ "$was_running" = 0 ]; then
    spin "Preparing the shared reverse proxy" pcompose up --no-start --force-recreate || { proxy_restore "$snap"; die "Could not create the shared reverse proxy (see $UPDATE_LOG)."; }
  fi
  dst=$(volume_at "$(pcompose ps -aq caddy | sed -n 1p)" /data)
  [ -n "$src" ] && [ -n "$dst" ] || { proxy_restore "$snap"; die "Could not find the certificate volumes (caddy_data)."; }

  # From here, the site is briefly unavailable (a few seconds).
  local done=0
  spin "Stopping the Caddy of $NAME (installation made with 1.0.x)" docker stop "$legacy" || true
  if spin "Copying its certificates into the shared reverse proxy ($src → $dst)" copy_volume "$src" "$dst" "$image"; then
    if [ "$was_running" = 1 ]; then
      spin "Reloading the shared reverse proxy" proxy_reload_running && done=1
    else
      spin "Starting the shared reverse proxy" proxy_start && done=1
    fi
  fi
  if [ "$done" = 1 ] && spin "Checking $(instance_url "$NAME") through the shared reverse proxy" proxy_check_site "$NAME"; then
    spin "Removing the old Caddy container (its volumes are kept)" docker rm "$legacy" || true
    ok "The shared reverse proxy serves $NAME, with the certificates of its previous Caddy"
    return 0
  fi
  last_log_lines 6
  if [ "$was_running" = 0 ]; then proxy_discard; fi
  proxy_restore "$snap"
  if [ "$was_running" = 1 ]; then proxy_reload_running >>"$UPDATE_LOG" 2>&1 || true; fi
  spin "Starting the Caddy of $NAME again" docker start "$legacy" || true
  die "The shared reverse proxy could not take over $NAME: its previous Caddy serves it again (details: $UPDATE_LOG)."
}

# proxy_upgrade VERSION — the proxy follows the newest installed version:
# image checked with the current configuration, container recreated, previous
# version started again on failure.
proxy_upgrade() {
  local v=$1 refresh=${2:-0} cur image snap new_files=0
  proxy_exists || return 0
  cur=$(penv_get HUMBLE_CADDY_VERSION)
  if [ -n "$cur" ] && ! version_gt "$v" "$cur"; then return 0; fi
  take_proxy_lock
  image="$(proxy_repo):$v"
  if ! docker image inspect "$image" >/dev/null 2>&1; then
    if [ "$(penv_get HUMBLE_PULL)" = 0 ]; then
      warn "$image is not available locally (HUMBLE_PULL=0): the shared reverse proxy keeps v$cur."
      return 1
    fi
    spin "Downloading $image" docker pull "$image" || return 1
  fi
  # `update`: the files of the proxy follow its image (install.sh writes them itself).
  if [ "$refresh" = 1 ] && [ "$(penv_get HUMBLE_PULL)" = 0 ]; then
    info "HUMBLE_PULL=0 (offline): the current proxy files are kept."
  elif [ "$refresh" = 1 ]; then
    if spin "Fetching the proxy files of v$v" proxy_files_prepare "v$v"; then
      new_files=1
    else
      warn "The proxy files of v$v could not be fetched or checked: the current ones are kept (see $UPDATE_LOG)."
    fi
  fi
  # The new image ships the maintenance page: the sites made before get it.
  snap=$(proxy_snapshot)
  if [ "$new_files" = 1 ]; then proxy_files_install; fi
  migrate_sites_note
  if ! spin "Checking the proxy configuration with $image" proxy_validate_with "$v"; then
    proxy_restore "$snap"
    if [ "$new_files" = 1 ]; then proxy_files_restore; fi
    last_log_lines 4
    return 1
  fi
  if proxy_running; then
    if ! spin "Moving the shared reverse proxy to v$v (a few seconds)" proxy_recreate "$v"; then
      proxy_restore "$snap"
      if [ "$new_files" = 1 ]; then proxy_files_restore; fi
      spin "Starting the shared reverse proxy v$cur again" proxy_start || true
      return 1
    fi
  fi
  kv_set "$PROXY_ENV" 600 HUMBLE_CADDY_VERSION "$v"
  ok "Shared reverse proxy: $image"
}

# proxy_files_prepare TAG — docker-compose.yml and site-template.caddy of the
# proxy at TAG (source settings of the first instance it serves), checked,
# into $TMP_DIR/proxy-files/; only the files that differ stay there.
proxy_files_prepare() {
  local tag=$1 d="$TMP_DIR/proxy-files" n="" f
  rm -rf -- "${d:?}"
  mkdir -p "$d"
  for f in $(instance_names); do proxied "$f" && { n=$f; break; }; done
  [ -n "$n" ] || { echo "No instance uses the proxy."; return 1; }
  ( ENV_FILE="$(reg_get "$n" DIR)/.env"
    release_file "$tag" deploy/proxy/docker-compose.yml "$d/docker-compose.yml" &&
      release_file "$tag" deploy/Caddyfile "$d/site-template.caddy" ) || return 1
  grep -q '__SITE_ADDRESS__' "$d/site-template.caddy" || { echo "deploy/Caddyfile of $tag is not a site template."; return 1; }
  HUMBLE_CADDY_VERSION=${tag#v} docker compose --project-directory "$PROXY_DIR" -f "$d/docker-compose.yml" config -q || return 1
  for f in docker-compose.yml site-template.caddy; do
    if cmp -s "$d/$f" "$PROXY_DIR/$f"; then rm -f -- "${d:?}/$f"; else echo "$f changes in $tag"; fi
  done
}

# The current files go to $TMP_DIR/proxy-files.prev/ (and the Compose file to
# docker-compose.yml.bak-<date>, as install.sh does), then the new ones in place.
proxy_files_install() {
  local d="$TMP_DIR/proxy-files" prev="$TMP_DIR/proxy-files.prev" f
  mkdir -p "$prev"
  for f in "$d"/*; do
    [ -f "$f" ] || continue
    f=${f##*/}
    if [ -f "$PROXY_DIR/$f" ]; then cp -p "$PROXY_DIR/$f" "$prev/$f"; fi
    if [ "$f" = docker-compose.yml ] && [ -f "$PROXY_DIR/$f" ]; then cp -p "$PROXY_DIR/$f" "$PROXY_DIR/$f.bak-$(date +%Y%m%d%H%M%S)"; fi
    install -m 0640 "$d/$f" "$PROXY_DIR/$f"
    info "Proxy file updated: $PROXY_DIR/$f"
  done
  [ ! -f "$PROXY_DIR/site-template.caddy" ] || chmod 0644 "$PROXY_DIR/site-template.caddy"
}

proxy_files_restore() {
  local f
  for f in "$TMP_DIR/proxy-files.prev"/*; do
    [ -f "$f" ] || continue
    cp -p "$f" "$PROXY_DIR/${f##*/}"
  done
}

proxy_validate_with() { HUMBLE_CADDY_VERSION=$1 pcompose run --rm --no-deps -T caddy caddy validate "${CADDY_CONFIG[@]}"; }
proxy_recreate() { HUMBLE_CADDY_VERSION=$1 pcompose up -d --wait --wait-timeout 60 caddy && proxy_alive; }

# proxy_remove_site NAME — the site and token go, the proxy reloads; on
# failure, they are restored (the caller stops).
proxy_remove_site() {
  local name=$1 snap
  proxy_exists && { [ -f "$PROXY_CONF/sites/$name.caddy" ] || [ -f "$PROXY_CONF/secrets/$name.cloudflare-token" ]; } || return 0
  take_proxy_lock
  snap=$(proxy_snapshot)
  rm -f "$PROXY_CONF/sites/$name.caddy" "$PROXY_CONF/sites/$name.caddy".bak-* "$PROXY_CONF/secrets/$name.cloudflare-token"
  # The main Caddyfile no longer lists it among the Cloudflare sites.
  proxy_apply "$snap" 0
}

proxy_sites() {
  local f
  for f in "$PROXY_CONF"/sites/*.caddy; do [ -f "$f" ] || continue; f=${f##*/}; printf '%s\n' "${f%.caddy}"; done
}

cmd_proxy() {
  local sub=${1:-status}
  [ $# -gt 0 ] && shift
  require_root proxy "$sub"
  UPDATE_LOG="$LOG_DIR/proxy.log"
  touch "$UPDATE_LOG" 2>/dev/null && chmod 600 "$UPDATE_LOG" 2>/dev/null || true
  case "$sub" in
    add-site) cmd_proxy_add_site "$@" ;;
    adopt) cmd_proxy_adopt "$@" ;;
    upgrade)
      [ -n "${1:-}" ] || die "Usage: humble-planning proxy upgrade X.Y.Z" 2
      proxy_require
      proxy_upgrade "$1" || die "The shared reverse proxy keeps v$(penv_get HUMBLE_CADDY_VERSION) (details: $UPDATE_LOG)." ;;
    status)
      if ! proxy_exists; then info "No shared reverse proxy on this server (no instance uses Caddy)."; return 0; fi
      local n site state=stopped
      proxy_running && state=running
      say ""
      say "  ${BOLD}Shared reverse proxy (Caddy)${RESET}  ${DIM}$(proxy_repo):$(penv_get HUMBLE_CADDY_VERSION)${RESET}"
      say "  ${DIM}Directory   ${RESET} $PROXY_DIR"
      say "  ${DIM}State       ${RESET} $state, ports $(penv_get HP_HTTP_PORT)/$(penv_get HP_HTTPS_PORT)"
      say "  ${DIM}Sites       ${RESET}"
      while IFS= read -r n; do
        [ -n "$n" ] || continue
        site=$(sed -n '/^[^#[:space:]].*{$/{s/ {$//p;q}' "$PROXY_CONF/sites/$n.caddy")
        say "    $(pad "$n" 14) $site$(is_instance "$n" || printf ' %s(no such instance)%s' "$YELLOW" "$RESET")"
      done < <(proxy_sites)
      [ -n "$(proxy_sites)" ] || say "    (none)"
      say ""
      pcompose ps ;;
    logs) proxy_require; pcompose logs -f --tail=200 "$@" ;;
    restart)
      proxy_require
      take_proxy_lock
      if proxy_running; then spin "Restarting the shared reverse proxy" pcompose restart caddy || die "The restart failed (see $UPDATE_LOG)."
      else spin "Starting the shared reverse proxy" proxy_start || die "The proxy did not start (see $UPDATE_LOG)."
      fi ;;
    reload)
      proxy_require
      take_proxy_lock
      local snap
      snap=$(proxy_snapshot)
      proxy_apply "$snap" 0 || die "The configuration was not applied: the shared reverse proxy keeps its previous one."
      ok "Configuration applied: $PROXY_CONF" ;;
    *) die "Usage: humble-planning proxy status|logs|restart|reload" 2 ;;
  esac
}

# ─── Public URL ──────────────────────────────────────────────────────────────

# URL rules of install.sh: http or https, a host, an optional port, no path.
URL_SCHEME="" URL_HOST="" URL_PORT=""
parse_url() {
  local u=${1%/}
  if [[ $u =~ ^(https?)://([A-Za-z0-9.-]+|\[[0-9A-Fa-f:]+\])(:([0-9]{1,5}))?$ ]]; then
    URL_SCHEME=${BASH_REMATCH[1]} URL_HOST=${BASH_REMATCH[2],,} URL_PORT=${BASH_REMATCH[4]}
    [ -z "$URL_PORT" ] || { [ "$URL_PORT" -ge 1 ] && [ "$URL_PORT" -le 65535 ]; } || return 1
    # The default port is not part of the origin a browser sends.
    if { [ "$URL_SCHEME" = https ] && [ "$URL_PORT" = 443 ]; } || { [ "$URL_SCHEME" = http ] && [ "$URL_PORT" = 80 ]; }; then URL_PORT=""; fi
    return 0
  fi
  return 1
}
url_origin() { printf '%s://%s%s' "$URL_SCHEME" "$URL_HOST" "${URL_PORT:+:$URL_PORT}"; }

is_ipv4() { [[ $1 =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; }
is_ip() { is_ipv4 "$1" || [[ $1 == *:* ]]; }
# A name that can get a public certificate (same rule as install.sh)
is_public_domain() {
  local h=$1
  ! is_ip "$h" && [[ $h == *.* ]] && [[ $h =~ \.[a-z]{2,}$ ]] && [[ ! $h =~ \.(local|localhost|internal|lan|home|test|invalid|example)$ ]]
}

# Cloudflare API, as install.sh validates a token: active, and a zone visible
# for the host (Zone.Zone:Read). The token goes through stdin, never argv.
CF_ERROR="" CF_ZONE=""
cf_api() {
  printf 'Authorization: Bearer %s\n' "$1" |
    curl -sS --max-time 20 -H @- -H 'Content-Type: application/json' "https://api.cloudflare.com/client/v4$2"
}
cf_message() { grep -o '"message":"[^"]*"' <<<"$1" | sed -n 1p | cut -d'"' -f4 || true; }
cf_check_token() {
  local token=$1 host=$2 body candidate
  CF_ERROR="" CF_ZONE=""
  if ! body=$(cf_api "$token" "/user/tokens/verify" 2>&1); then
    CF_ERROR="Could not reach api.cloudflare.com: $body"; return 1
  fi
  if [[ $body != *'"success":true'* || $body != *'"status":"active"'* ]]; then
    CF_ERROR="Cloudflare rejected the token${body:+: $(cf_message "$body")}"; return 1
  fi
  candidate=$host
  while [[ $candidate == *.* ]]; do
    body=$(cf_api "$token" "/zones?name=$candidate" 2>&1) || { CF_ERROR="Could not reach api.cloudflare.com."; return 1; }
    if [[ $body == *'"success":false'* ]]; then
      CF_ERROR="Cloudflare refused to list zones: $(cf_message "$body") (the token needs Zone → Zone → Read)."; return 1
    fi
    if [[ $body == *'"success":true'* && $body != *'"result":[]'* ]]; then CF_ZONE=$candidate; return 0; fi
    candidate=${candidate#*.}
  done
  CF_ERROR="The token is valid but no Cloudflare zone is visible for $host (check its \"Zone Resources\")."
  return 1
}

# A site without its generated header (two comment lines with a date) and the
# maintenance import (added to the sites of 1.1.0 by proxy_migrate_sites)
site_body() { grep -v -e '^# Humble Planning — site of the instance' -e '^# Kept across updates' -e 'humble-maintenance' "$@" || true; }

# The instance runs again on its current .env: app and socket recreated, then
# the health check (and the proxy, when it serves the site).
recreate_and_check() {
  compose up -d --force-recreate --no-deps --wait --wait-timeout 180 app socket &&
    wait_http "http://127.0.0.1:$(env_get HP_APP_PORT)/login" 90
}

# Everything set-url changed goes back: .env, registry, proxy files (then a
# reload), nginx example, and the instance runs again on the previous URL.
SETURL_SNAP="" SETURL_PROXY_SNAP=""
set_url_rollback() {
  local reason=$1
  title "Restoring the previous URL of $NAME"
  cp -p "$SETURL_SNAP/env" "$ENV_FILE"
  cp -p "$SETURL_SNAP/registry" "$REGISTRY_DIR/$NAME.conf"
  [ ! -f "$SETURL_SNAP/nginx-example.conf" ] || cp -p "$SETURL_SNAP/nginx-example.conf" "$INSTALL_DIR/nginx-example.conf"
  if [ -n "$SETURL_PROXY_SNAP" ]; then
    proxy_restore "$SETURL_PROXY_SNAP"
    if proxy_running; then spin "Reloading the previous configuration of the shared reverse proxy" proxy_reload_running || true; fi
  fi
  # Compose recreates app and socket only if they run with the new .env.
  if spin "Starting $NAME again on $(env_get APP_BASE_URL)" compose up -d --wait --wait-timeout 180; then
    ok "$NAME runs again on $(env_get APP_BASE_URL)"
  else
    bad "$NAME did not start again: check 'humble-planning logs $NAME'."
  fi
  die "The URL was not changed: $reason (details: $UPDATE_LOG)."
}

# humble-planning set-url [instance] <url> [--yes] [--token-stdin]
cmd_set_url() {
  local yes=0 stdin=0 pos=() new new_host old old_scheme new_tls old_tls n other site="" hand=0 bak="" token=""
  INSTANCE_ARG=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -y|--yes) yes=1 ;;
      --token-stdin) stdin=1 ;;
      -*) die "Unknown option for set-url: $1" 2 ;;
      *) pos+=("$1") ;;
    esac
    shift
  done
  require_root set-url
  case "${#pos[@]}" in
    1) new=${pos[0]} ;;
    2) is_instance "${pos[0]}" || { print_instances; die "Unknown instance: ${pos[0]}" 2; }
       INSTANCE_ARG=${pos[0]} new=${pos[1]} ;;
    *) die "Usage: humble-planning set-url [instance] <url> [--yes] [--token-stdin]" 2 ;;
  esac
  parse_url "$new" || die "Invalid URL \"$new\": use http:// or https://, a host and an optional port, no path (e.g. https://planning.example.com)." 2
  new=$(url_origin)
  if [ -z "$INSTANCE_ARG" ] && [ "$(instance_names | grep -c .)" -gt 1 ] && ! interactive; then
    print_instances; say ""
    die "Several instances are installed: name one, e.g. humble-planning set-url $(instance_names | sed -n 1p) $new" 2
  fi
  resolve_instance set-url

  # ── Checks: nothing has changed yet ──
  old=$(env_get APP_BASE_URL)
  if parse_url "$old"; then old=$(url_origin); old_scheme=$URL_SCHEME; else old_scheme=""; fi
  [ "$new" != "$old" ] || die "$NAME already uses $new: nothing to change." 2
  parse_url "$new"; new_host=$URL_HOST
  while IFS= read -r n; do
    [ -n "$n" ] && [ "$n" != "$NAME" ] || continue
    other=$(instance_url "$n")
    if parse_url "$other" && [ "$URL_HOST" = "$new_host" ]; then
      die "$new_host is already used by the instance $n ($other)." 2
    fi
  done < <(instance_names)
  parse_url "$new"
  old_tls=$(reg_get "$NAME" TLS) new_tls=$old_tls
  if proxied; then
    proxy_require
    [ -z "$URL_PORT" ] || die "With the shared reverse proxy, the URL cannot include a port ($URL_PORT): it serves ports $(penv_get HP_HTTP_PORT)/$(penv_get HP_HTTPS_PORT)." 2
    if [ "$URL_SCHEME" = http ]; then
      new_tls=http
    elif is_public_domain "$URL_HOST"; then
      new_tls=acme
    else
      die "No public certificate can be issued for $URL_HOST: use http://$URL_HOST, or a public domain name." 2
    fi
    site="$PROXY_CONF/sites/$NAME.caddy"
    # The Cloudflare DNS challenge needs a token that covers the new zone.
    if [ "$new_tls" = acme ] && [ "$(reg_get "$NAME" CF_DNS)" = 1 ]; then
      if [ "$stdin" = 1 ]; then
        IFS= read -r token || true; token=${token%$'\r'}
        [ -n "$token" ] || die "--token-stdin: no Cloudflare API token on stdin." 2
      elif [ -s "$PROXY_CONF/secrets/$NAME.cloudflare-token" ]; then
        token=$(head -n1 "$PROXY_CONF/secrets/$NAME.cloudflare-token")
      else
        die "The Cloudflare API token of $NAME is missing: give one with --token-stdin." 2
      fi
      info "Checking the Cloudflare API token for $URL_HOST…"
      cf_check_token "$token" "$URL_HOST" ||
        die "The Cloudflare API token cannot issue a certificate for $URL_HOST: $CF_ERROR Nothing was changed; give another token with --token-stdin (Zone.Zone:Read + Zone.DNS:Edit on its zone)." 2
      ok "Cloudflare token valid for the zone $CF_ZONE"
    elif [ "$stdin" = 1 ]; then
      die "--token-stdin only applies to a site using the Cloudflare DNS challenge over HTTPS." 2
    fi
    # Hand edits are kept in a backup, never lost silently.
    if [ -f "$site" ] && [ "$(proxy_render_site "$NAME" | site_body)" != "$(site_body "$site")" ]; then hand=1; fi
  elif [ "$stdin" = 1 ]; then
    die "--token-stdin only applies to an instance served by the shared reverse proxy." 2
  fi

  # ── What will change ──
  title "Changing the public URL of $NAME — $LABEL"
  say "  ${DIM}URL              ${RESET} $old → ${BOLD}$new${RESET}"
  say "  ${DIM}.env             ${RESET} APP_BASE_URL and BETTER_AUTH_URL ($ENV_FILE)"
  if proxied; then
    say "  ${DIM}Proxy site       ${RESET} $site, generated again for $URL_HOST$( [ "$new_tls" != "$old_tls" ] && echo " (HTTPS: $old_tls → $new_tls)"), then checked and reloaded"
  else
    say "  ${DIM}Reverse proxy    ${RESET} yours: update it for $URL_HOST$( [ -f "$INSTALL_DIR/nginx-example.conf" ] && echo " (nginx-example.conf updated)")"
  fi
  say "  ${DIM}Restart          ${RESET} app and socket of $NAME (a few seconds of unavailability)"
  say ""
  if [ -n "$old_scheme" ] && [ "$old_scheme" != "$URL_SCHEME" ]; then
    warn "The URL switches from $old_scheme to $URL_SCHEME: the session cookies change, ${BOLD}everyone is signed out${RESET}."
  fi
  warn "MCP clients and OAuth connections (AI assistants) must reconnect with the new URL."
  info "The DNS record of $URL_HOST must already point to this server$( [ "$new_tls" = acme ] && echo " (needed for its certificate)")."
  if [ "$hand" = 1 ]; then
    warn "${BOLD}$site was changed by hand${RESET}: it is generated again from the template; the current file is kept as a backup, carry your changes over."
  fi
  say ""
  if [ "$yes" = 0 ]; then
    interactive || die "Changing the URL needs a confirmation: humble-planning set-url $NAME $new --yes" 2
    confirm "Change the URL of $NAME to $new?" y || quit "Nothing was changed."
  fi

  # ── Changes, each one restored on failure ──
  take_lock
  proxied && take_proxy_lock
  SETURL_SNAP="$TMP_DIR/set-url"
  install -d -m 0700 "$SETURL_SNAP"
  cp -p "$ENV_FILE" "$SETURL_SNAP/env"
  cp -p "$REGISTRY_DIR/$NAME.conf" "$SETURL_SNAP/registry"
  [ ! -f "$INSTALL_DIR/nginx-example.conf" ] || cp -p "$INSTALL_DIR/nginx-example.conf" "$SETURL_SNAP/nginx-example.conf"
  proxied && SETURL_PROXY_SNAP=$(proxy_snapshot)

  env_set APP_BASE_URL "$new" BETTER_AUTH_URL "$new"
  [ "$new_tls" = "$old_tls" ] || kv_set "$REGISTRY_DIR/$NAME.conf" 644 TLS "$new_tls"
  ok ".env: APP_BASE_URL and BETTER_AUTH_URL = $new"
  if proxied; then
    if [ -f "$site" ]; then
      bak="$site.bak-$(date +%Y%m%d%H%M%S)"
      cp -p "$site" "$bak"
    fi
    TOKEN=$token
    write_site "$NAME" || set_url_rollback "the site could not be written"
    proxy_apply "$SETURL_PROXY_SNAP" 0 || set_url_rollback "the shared reverse proxy refused the new site"
  elif [ -f "$INSTALL_DIR/nginx-example.conf" ]; then
    sed -i -E "s/^([[:space:]]*server_name)[[:space:]].*;/\1 $URL_HOST;/" "$INSTALL_DIR/nginx-example.conf"
  fi
  spin "Restarting $NAME on $new" recreate_and_check || { last_log_lines 6; set_url_rollback "$NAME did not start on the new URL"; }
  if proxied && proxy_running && [ "$new_tls" != acme ]; then
    spin "Checking $new through the shared reverse proxy" proxy_check_site "$NAME" || { last_log_lines 3; set_url_rollback "the shared reverse proxy does not serve $new"; }
  elif proxied && proxy_running; then
    spin "Checking that the shared reverse proxy reaches $NAME" proxy_check_site "$NAME" || { last_log_lines 3; set_url_rollback "the shared reverse proxy does not reach $NAME"; }
  fi

  # ── Summary ──
  say ""
  ok "${BOLD}$NAME now answers on $new${RESET} (previously $old)"
  if proxied; then
    info "Proxy site: $site${bak:+ (previous one kept as $bak)}"
    [ "$new_tls" != acme ] || info "Caddy requests the certificate of $URL_HOST now: humble-planning proxy logs"
    proxy_running || warn "The shared reverse proxy is stopped: start it with 'humble-planning proxy restart'."
  else
    warn "Update your reverse proxy: serve $new (/socket.io/* → 127.0.0.1:$(env_get HP_SOCKET_PORT), the rest → 127.0.0.1:$(env_get HP_APP_PORT)), with a certificate for $URL_HOST."
  fi
  [ "$hand" = 0 ] || warn "Carry your changes over from $bak to $site, then: humble-planning proxy reload"
  info "Signed-in users may have to sign in again; MCP and OAuth clients must reconnect to $new."
  log "URL   $NAME: $old → $new"
}

# ─── Remove ──────────────────────────────────────────────────────────────────

# The files of an instance, as install.sh and this command write them. The
# directory goes only once empty: anything else in it (other instances, the
# proxy, files that are not Humble Planning's) is kept, and so is the directory.
remove_instance_files() {
  local dir=$1
  [[ $dir == /*/* ]] && [ "$dir" != "$PROXY_DIR" ] || { echo "Refusing to remove $dir."; return 1; }
  rm -f -- "$dir/.env" "$dir/docker-compose.yml" "$dir/docker-compose.proxy.yml" "$dir"/docker-compose.yml.bak-* \
    "$dir/Caddyfile" "$dir"/Caddyfile.bak-* "$dir/nginx-example.conf" "$dir/.update-state" \
    "$dir"/backups/*.dump "$dir"/backups/*.dump.part
  rmdir -- "$dir/backups" 2>/dev/null || true
  rmdir -- "$dir" 2>/dev/null || echo "kept-dir"
}

# Containers, volumes and networks of the Compose project — those of older
# files too (the Caddy volumes of a 1.0.x installation).
remove_project() {
  local project=$1 label="label=com.docker.compose.project=$1" ids=()
  compose down --volumes --remove-orphans --timeout 30 || true
  mapfile -t ids < <(docker ps -aq --filter "$label")
  [ "${#ids[@]}" -eq 0 ] || docker rm -f "${ids[@]}"
  mapfile -t ids < <(docker volume ls -q --filter "$label")
  [ "${#ids[@]}" -eq 0 ] || docker volume rm "${ids[@]}"
  mapfile -t ids < <(docker network ls -q --filter "$label")
  [ "${#ids[@]}" -eq 0 ] || docker network rm "${ids[@]}"
  [ -z "$(docker ps -aq --filter "$label")$(docker volume ls -q --filter "$label")" ] || { echo "Docker resources of $project are left."; return 1; }
}

remove_proxy() {
  pcompose down --volumes --remove-orphans --timeout 30 || true
  if docker network inspect "$PROXY_NETWORK" >/dev/null 2>&1; then docker network rm "$PROXY_NETWORK"; fi
  rm -rf -- "$PROXY_DIR"
}

cmd_remove() {
  local name="" yes=0 confirm_name="" backup=1 rm_proxy="" ans
  while [ $# -gt 0 ]; do
    case "$1" in
      -y|--yes) yes=1 ;;
      --confirm) confirm_name=${2:-}; shift ;;
      --confirm=*) confirm_name=${1#*=} ;;
      --no-backup) backup=0 ;;
      --remove-proxy) rm_proxy=1 ;;
      --keep-proxy) rm_proxy=0 ;;
      -*) die "Unknown option for remove: $1" 2 ;;
      *) [ -z "$name" ] || die "Remove one instance at a time." 2; name=$1 ;;
    esac
    shift
  done
  require_root remove
  check_legacy
  if [ -z "$name" ]; then
    [ -z "$(instance_names)" ] || print_instances
    say ""
    die "Name the instance to remove: humble-planning remove <instance>" 2
  fi
  is_instance "$name" || { [ -z "$(instance_names)" ] || print_instances; die "Unknown instance: $name" 2; }
  select_instance "$name"

  local project version url volumes site="" token="" timer final="" envcopy="" summary=()
  project=$(env_get COMPOSE_PROJECT_NAME) version=$(env_get HUMBLE_VERSION) url=$(env_get APP_BASE_URL)
  volumes=$(docker volume ls -q --filter "label=com.docker.compose.project=$project" | paste -sd' ' -)
  [ -f "$PROXY_CONF/sites/$NAME.caddy" ] && site="$PROXY_CONF/sites/$NAME.caddy"
  [ -f "$PROXY_CONF/secrets/$NAME.cloudflare-token" ] && token="$PROXY_CONF/secrets/$NAME.cloudflare-token"
  timer=$(auto_update_state)

  title "Removing the instance $NAME — $LABEL"
  say "  ${DIM}URL              ${RESET} $url (v$version)"
  say "  ${DIM}Directory        ${RESET} $INSTALL_DIR"
  say "  ${DIM}Containers       ${RESET} Compose project $project (app, socket$(db_builtin && echo ", db"))"
  say "  ${DIM}Volumes          ${RESET} ${volumes:-none}"
  if db_builtin; then say "  ${DIM}Database         ${RESET} built-in: ${BOLD}deleted with its volume${RESET}"
  else say "  ${DIM}Database         ${RESET} external: backed up, then left untouched on its server"; fi
  [ -n "$site" ] && say "  ${DIM}Proxy site       ${RESET} $site"
  [ -n "$token" ] && say "  ${DIM}Cloudflare token ${RESET} $token"
  [ "$timer" != off ] && say "  ${DIM}Automatic update ${RESET} $timer, disabled"
  if [ "$backup" = 1 ]; then say "  ${DIM}Final backup     ${RESET} kept in $FINAL_BACKUP_DIR"
  else say "  ${DIM}Final backup     ${RESET} ${YELLOW}none (--no-backup)${RESET}"; fi
  say ""

  if [ "$yes" = 1 ] && [ "$confirm_name" = "$NAME" ]; then
    :
  elif interactive; then
    printf '  %s?%s Everything listed above is deleted. Type the name of the instance (%s) to confirm: ' "$ACCENT" "$RESET" "$NAME"
    IFS= read -r ans </dev/tty || die "No input available." 2
    [ "$ans" = "$NAME" ] || quit "Removal cancelled: nothing was changed."
  else
    die "Removing an instance needs a confirmation: humble-planning remove $NAME --yes --confirm $NAME" 2
  fi
  take_lock

  # 1. Final backup, outside the instance directory (with its .env: the
  # secrets needed to restore it elsewhere).
  if [ "$backup" = 1 ]; then
    install -d -m 0700 "$FINAL_BACKUP_DIR"
    final="$FINAL_BACKUP_DIR/$NAME-final-v$version-$(date +%Y%m%d-%H%M%S).dump"
    db_builtin && { spin "Starting the database of $NAME" compose up -d --wait --wait-timeout 120 db || true; }
    if ! spin "Final backup of the database" backup_to "$final"; then
      rm -f "$final.part"
      last_log_lines 10
      die "The final backup failed: nothing was removed. To remove $NAME without it: humble-planning remove $NAME --no-backup"
    fi
    envcopy="${final%.dump}.env"
    ( umask 077; cp "$ENV_FILE" "$envcopy" )
    summary+=("final backup: $final ($(du -h "$final" | cut -f1))" "its settings and secrets: $envcopy")
  fi

  # 2. The site leaves the proxy first: nothing is deleted if Caddy refuses
  # the new configuration.
  if [ -n "$site" ] || [ -n "$token" ]; then
    proxy_remove_site "$NAME" || die "The shared reverse proxy refused its new configuration: nothing else was removed${final:+ (final backup: $final)}."
    [ -z "$site" ] || summary+=("site of the shared reverse proxy: $site")
    [ -z "$token" ] || summary+=("Cloudflare API token of the site: $token")
  fi

  # 3. Containers, volumes, network
  if ! spin "Removing the containers, volumes and network of $NAME" remove_project "$project"; then
    last_log_lines 10
    die "Some Docker resources of $project could not be removed: run the command again (details: $UPDATE_LOG)."
  fi
  summary+=("containers, volumes and network of the Compose project $project${volumes:+ ($volumes)}")

  # 4. Automatic updates, directory, registry
  if [ "$timer" != off ]; then auto_update_off; summary+=("nightly automatic update ($timer)"); fi
  local kept
  kept=$(remove_instance_files "$INSTALL_DIR") || die "$kept"
  if [ "$kept" = kept-dir ]; then summary+=("files of the instance in $INSTALL_DIR (the directory holds other files: kept)")
  else summary+=("directory $INSTALL_DIR"); fi
  rm -f "$REGISTRY_DIR/$NAME.conf" "$LOCK_FILE"
  summary+=("registry entry $REGISTRY_DIR/$NAME.conf")

  # 5. The proxy, once no instance uses it any more
  local n users=0
  while IFS= read -r n; do [ -n "$n" ] && proxied "$n" && users=$((users + 1)); done < <(instance_names)
  if [ "$users" = 0 ] && proxy_exists; then
    if [ -z "$rm_proxy" ]; then
      rm_proxy=0
      if interactive; then
        say ""
        confirm "No other instance uses the shared reverse proxy. Stop and remove it too (container, network, certificates)?" n && rm_proxy=1
      else
        info "No other instance uses the shared reverse proxy: remove it with 'humble-planning remove … --remove-proxy', or keep it for the next instance."
      fi
    fi
    if [ "$rm_proxy" = 1 ]; then
      take_proxy_lock
      if spin "Removing the shared reverse proxy" remove_proxy; then summary+=("shared reverse proxy: container, network $PROXY_NETWORK, certificates, $PROXY_DIR")
      else warn "The shared reverse proxy could not be removed completely (see $UPDATE_LOG)."; fi
    fi
  fi

  say ""
  ok "${BOLD}The instance $NAME was removed.${RESET}"
  for n in "${summary[@]}"; do info "$n"; done
  if [ -n "$final" ]; then
    say ""
    say "  ${BOLD}Final backup:${RESET} $final"
    say "  ${DIM}Restore it in another instance with the same secrets ($envcopy).${RESET}"
  fi
  [ -n "$(instance_names)" ] || info "No instance left on this server. To install one: sudo humble-planning new"
}

# ─── New instance ────────────────────────────────────────────────────────────

# latest_release_tag — highest vX.Y.Z tag of a published release (no draft, no
# pre-release) in the GitHub releases JSON on stdin, as `update` reads it.
# Plain shell: it must work without any instance, hence without the app image
# that `update` parses the list with. The keys of a release come in the order
# tag_name, …, draft, …, prerelease; the escaped quotes of a release body
# (\"draft\") never match.
latest_release_tag() { release_tags | tail -n1; }

# release_tags — every vX.Y.Z tag of a published release, lowest first (stdin: JSON)
release_tags() {
  tr ',{}[]' '\n\n\n\n\n' |
    sed -n -E 's/^[[:space:]]*"(tag_name|draft|prerelease)"[[:space:]]*:[[:space:]]*"?([^"[:space:]]*)"?[[:space:]]*$/\1 \2/p' |
    awk '
      function flush() { if (tag ~ /^v?[0-9]+\.[0-9]+\.[0-9]+$/ && draft == "false" && pre == "false") print tag }
      $1 == "tag_name" { flush(); tag = $2; draft = ""; pre = "" }
      $1 == "draft" { draft = $2 }
      $1 == "prerelease" { pre = $2 }
      END { flush() }' |
    sort -V
}

# A first instance gives the release source (HUMBLE_UPDATE_SOURCE/REPO);
# without any, the environment or the official repository.
cmd_new() {
  local first tag repo src url file="$TMP_DIR/install.sh" json="$TMP_DIR/new-releases.json" rc=0
  require_root new
  UPDATE_LOG="$LOG_DIR/humble-planning.log"
  first=$(instance_names | sed -n 1p)
  [ -z "$first" ] || ENV_FILE="$(reg_get "$first" DIR)/.env"
  repo=$(env_get HUMBLE_UPDATE_REPO); repo=${HUMBLE_UPDATE_REPO:-${repo:-$DEFAULT_UPDATE_REPO}}
  src=${HUMBLE_UPDATE_SOURCE:-$(env_get HUMBLE_UPDATE_SOURCE)}

  # One `new` at a time. The installer takes no lock of its own; the locks it
  # gets through this command (proxy, instance) are other files, and the child
  # does not inherit this one (7>&-): no deadlock.
  install -d -m 0755 "$LOCK_DIR" 2>/dev/null || true
  exec 7>"$LOCK_DIR/humble-planning-new.lock"
  flock -n 7 || die "Another new instance is being installed on this server."

  if ! spin "Looking for the latest release" fetch_releases "$json"; then
    die "Could not download the release list (network, GitHub API rate limit or HUMBLE_UPDATE_SOURCE). Install the new instance with: $INSTALL_COMMAND"
  fi
  tag=$(latest_release_tag <"$json")
  [ -n "$tag" ] || die "No published release found in the release list. Install the new instance with: $INSTALL_COMMAND"
  url=${HUMBLE_INSTALLER_URL:-"https://raw.githubusercontent.com/$repo/{tag}/install.sh"}
  url=${url//\{tag\}/$tag}
  ( umask 077; : >"$file" )
  if ! spin "Downloading the installer of $tag" curl -fsSL --retry 3 --max-time 60 -o "$file" "$url"; then
    die "Could not download $url. Install the new instance with: $INSTALL_COMMAND"
  fi
  # A truncated download, an error page or a corrupted file is never run.
  [ -s "$file" ] && head -n1 "$file" | grep -qE '^#!.*[/ ]bash([[:space:]]|$)' ||
    die "$url is not the Humble Planning installer (empty file or no bash shebang): nothing was run."
  bash -n "$file" 2>>"$UPDATE_LOG" || die "The installer downloaded from $url has syntax errors: nothing was run."
  # Installers older than 1.1.0 know a single instance: they would update the
  # existing one instead of adding another.
  grep -q 'HP_ACTION' "$file" || die "The installer of $tag (released before 1.1.0) cannot add an instance: nothing was run."
  chmod 600 "$file"
  log "NEW   $url ($tag)"

  # The HP_* variables of the environment reach the installer; it fetches its
  # files and images from the same release, and the new instance reads the
  # same release list (mirror, repository), unless they are set.
  HP_ACTION=new HP_VERSION=${HP_VERSION:-${tag#v}} \
    HP_REPO_RAW=${HP_REPO_RAW:-https://raw.githubusercontent.com/$repo/$tag} \
    HP_UPDATE_REPO=${HP_UPDATE_REPO:-$repo} HP_UPDATE_SOURCE=${HP_UPDATE_SOURCE:-$src} \
    bash "$file" "$@" 7>&- || rc=$?
  return "$rc"
}

# ─── Other commands ──────────────────────────────────────────────────────────

cmd_list() {
  require_root list
  check_legacy
  if [ -z "$(instance_names)" ]; then
    info "No Humble Planning instance is installed on this server. Install one: $NEW_HINT"
    return 0
  fi
  local n
  EXTRA=([__header]="$(pad STATE 12) CADDY")
  while IFS= read -r n; do
    EXTRA[$n]="$(pad "$(instance_state "$n")" 12) $(proxied "$n" && echo yes || echo no)"
  done < <(instance_names)
  print_instances
  say ""
  if proxy_exists; then
    say "  ${DIM}Shared reverse proxy: $(proxy_running && echo running || echo stopped), $(proxy_repo):$(penv_get HUMBLE_CADDY_VERSION), ports $(penv_get HP_HTTP_PORT)/$(penv_get HP_HTTPS_PORT) (humble-planning proxy status)${RESET}"
  fi
}

cmd_status() {
  local version previous last
  version=$(env_get HUMBLE_VERSION) previous=$(env_get HUMBLE_PREVIOUS_VERSION)
  say ""
  say "  ${BOLD}$NAME — $LABEL${RESET}  ${DIM}Humble Planning v${version:-?}, $(image_repo):${version:-?}${RESET}"
  say "  ${DIM}URL              ${RESET} $(env_get APP_BASE_URL)"
  say "  ${DIM}Installation     ${RESET} $INSTALL_DIR (Compose project $(env_get COMPOSE_PROJECT_NAME))"
  if proxied; then
    say "  ${DIM}Reverse proxy    ${RESET} shared Caddy, site $PROXY_CONF/sites/$NAME.caddy (humble-planning proxy status)"
  else
    say "  ${DIM}Reverse proxy    ${RESET} your own: app on 127.0.0.1:$(env_get HP_APP_PORT), Socket.io on 127.0.0.1:$(env_get HP_SOCKET_PORT)"
  fi
  if [ -n "$previous" ]; then say "  ${DIM}Previous version ${RESET} v$previous (humble-planning rollback $NAME)"; fi
  case "$(auto_update_state)" in
    off) say "  ${DIM}Automatic updates${RESET} disabled (humble-planning auto-update on $NAME)" ;;
    *) say "  ${DIM}Automatic updates${RESET} enabled, patch releases only" ;;
  esac
  last=$(state_get last_check)
  say "  ${DIM}Last update check${RESET} ${last:-never}${last:+ — $(state_get last_result)}"
  say ""
  compose ps "$@"
}

cmd_logs() {
  if [ "${1:-}" = caddy ]; then
    proxy_require
    pcompose logs -f --tail=200 caddy
  else
    compose logs -f --tail=200 "$@"
  fi
}

cmd_start() {
  spin "Starting $NAME" compose up -d --wait || { last_log_lines 10; die "$NAME did not start (see 'humble-planning logs $NAME')."; }
  if proxied && proxy_exists && ! proxy_running; then
    spin "Starting the shared reverse proxy" proxy_start || warn "The shared reverse proxy did not start: humble-planning proxy status"
  fi
}

usage() {
  cat <<EOF
Usage: humble-planning <command> [instance] [options]

The instance name can be left out when only one instance is installed; with
several, the command asks in a terminal (or stops with the list).

  list                         Instances: name, label, URL, version, state, Caddy
  new                          Install a new instance on this server (downloads the installer
                               of the latest release; HP_* variables: non-interactive mode)
  status [instance]            Version, update status and state of the containers
  logs [instance] [service]    Follow the logs (app, socket, db; caddy: the shared proxy)
  start | stop | restart [instance]
                               Start, stop or restart an instance
  update [instance…|--all]     Update to the latest (or given) release: release notes,
         [--version X.Y.Z]     database backup, migrations, automatic rollback on failure.
         [--yes] [--auto]      Several instances are updated one after the other, each with
                               its own backup and rollback; without a name, in a terminal,
                               choose them from the list. --auto: patch releases of the same
                               series only, no questions (nightly timer)
  rollback [instance] [--yes]  Go back to the previous version
           [--restore|--no-restore]  restore (or not) the pre-update database backup
  backup [instance]            Back up the database into <instance directory>/backups
  demo-reset [instance] [--force]
                               Demo instance: erase all the data and load the demo dataset now.
                               --force: also when the database holds data not created by the demo
  auto-update on|off|status [instance]
                               Nightly automatic updates (patch releases only)
  version [instance]           Print the installed version
  set-url [instance] <url> [--yes] [--token-stdin]
                               Change the public URL: .env, proxy site (checked, previous one
                               kept as a backup), restart; everything restored on failure
  remove <instance> [--yes --confirm <instance>] [--no-backup] [--remove-proxy|--keep-proxy]
                               Remove an instance: final backup (kept in $FINAL_BACKUP_DIR),
                               containers, volumes, files, proxy site, automatic updates
  proxy status|logs|restart|reload
                               Reverse proxy (Caddy) shared by the instances
  help                         Show this help

Instances: $REGISTRY_DIR — base directory: $BASE_DIR (from $CONFIG_FILE)
EOF
}

main() {
  ORIG_ARGS=("$@")
  TMP_DIR=$(mktemp -d)
  trap 'spinner_stop; rm -rf "$TMP_DIR"' EXIT
  trap 'die "Unexpected error on line $LINENO: $BASH_COMMAND"' ERR
  local cmd=${1:-help}
  [ $# -gt 0 ] && shift
  case "$cmd" in
    list|ls) cmd_list ;;
    new) cmd_new "$@" || exit $? ;;
    update) require_root update; cmd_update "$@" ;;
    remove) cmd_remove "$@" ;;
    set-url) cmd_set_url "$@" ;;
    proxy) cmd_proxy "$@" ;;
    help|-h|--help) usage ;;
    status|logs|start|stop|restart|rollback|backup|demo-reset|auto-update|version)
      require_root "$cmd"
      split_args "$cmd" "$@"
      resolve_instance "$cmd"
      set -- "${ARGS[@]}"
      case "$cmd" in
        status) cmd_status "$@" ;;
        logs) cmd_logs "$@" ;;
        start) cmd_start ;;
        stop) spin "Stopping $NAME" compose stop || die "$NAME did not stop (see $UPDATE_LOG)." ;;
        restart) compose restart "$@" || die "$NAME did not restart (see 'humble-planning logs $NAME')." ;;
        rollback) cmd_rollback "$@" ;;
        backup) cmd_backup ;;
        demo-reset) cmd_demo_reset "$@" ;;
        auto-update) cmd_auto_update "$@" ;;
        version) env_get HUMBLE_VERSION; echo ;;
      esac ;;
    *) usage; exit 2 ;;
  esac
}

# Run main unless the file is sourced (tests source it to reuse the helpers).
if [[ "${BASH_SOURCE[0]:-$0}" == "$0" ]]; then
  main "$@"
fi
