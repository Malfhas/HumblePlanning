#@template
# Humble Planning — site template of the shared reverse proxy (Caddy).
#
# `humble-planning` renders this file into <base dir>/proxy/caddy/sites/<name>.caddy
# for each instance served by the proxy (install.sh copies it next to the
# proxy as site-template.caddy):
#   __SITE_ADDRESS__  domain of the public URL, or http://<host> for plain HTTP
#   __NAME__          instance name: its containers are <name>-app and
#                     <name>-socket on the proxy network
#   __ACME_EMAIL__    optional e-mail address for Let's Encrypt (this site only)
# Blocks between "#@<name>" and "#@end" are kept only when enabled (a block
# nested in a skipped block is skipped too):
#   acme_email        an e-mail address was given, without the Cloudflare DNS challenge
#   cloudflare        ACME DNS-01 challenge through Cloudflare
#   https             the site is served over HTTPS
# The global options (Cloudflare's trusted proxies when a site is served
# through the Cloudflare proxy) are in the main Caddyfile, generated by
# `humble-planning`. The Cloudflare token is never written here: Caddy reads
# it from secrets/<name>.cloudflare-token, a file of the proxy only.
#@end
__SITE_ADDRESS__ {
	encode zstd gzip

	#@acme_email
	tls __ACME_EMAIL__
	#@end
	#@cloudflare
	tls __ACME_EMAIL__ {
		dns cloudflare {file./etc/caddy/humble/secrets/__NAME__.cloudflare-token}
	}
	#@end

	# Security headers: only set when the application did not set them.
	header {
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "SAMEORIGIN"
		?Referrer-Policy "strict-origin-when-cross-origin"
		#@https
		?Strict-Transport-Security "max-age=31536000; includeSubDomains"
		#@end
		-Server
		-X-Powered-By
	}

	# Socket.io (real-time updates) goes to the socket server, everything else
	# to the Next.js application. X-Real-IP is overwritten with the client
	# address resolved by Caddy ({client_ip}: the address of the connection,
	# or CF-Connecting-IP when the connection comes from a trusted proxy): the
	# application reads the client address from it, so a client cannot forge
	# it. CF-Connecting-IP itself is not passed on: the application never sees
	# an unchecked value.
	reverse_proxy /socket.io/* __NAME__-socket:3001
	reverse_proxy __NAME__-app:3000 {
		header_up X-Real-IP {client_ip}
		header_up -CF-Connecting-IP
	}
}
